---
// Base layout: fixed header, accessible navigation, and organization schema.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import { COMPANY } from '@/data/company';
import BrandLogo from '@/components/BrandLogo.astro';

interface Props {
  title: string;
  description: string;
  lang?: string;
  noindex?: boolean;
}

const { title, description, lang = 'en', noindex = false } = Astro.props;
const pageTitle = `${title} — ${COMPANY.name}`;
const pathname = Astro.url.pathname;
const isCurrent = (href: string) => pathname.startsWith(href);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon-bird.png?v=3" />
    <link rel="apple-touch-icon" href="/favicon-bird.png?v=3" />
    <title>{pageTitle}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: COMPANY.name,
        url: COMPANY.domain,
        email: COMPANY.email,
        telephone: COMPANY.phone,
        address: COMPANY.address,
        logo: `${COMPANY.domain}/images/brand/elg-logo-reference.png`,
      })}
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <style>
      ::selection {
        background: #d95f16;
        color: #fff;
      }
      :focus-visible {
        outline: 3px solid #d95f16;
        outline-offset: 3px;
      }
      :focus { scroll-margin-top: 5rem; }
      [data-motion-item], main article, main figure {
        transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 300ms ease, border-color 300ms ease;
      }
      [data-motion-item]:hover, main article:hover, main figure:hover {
        transform: translateY(-3px);
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body class="bg-white font-sans text-brand-ink antialiased">
    <a href="#main-content" class="fixed left-4 top-3 z-[60] -translate-y-20 rounded-md bg-brand-ink px-4 py-3 text-sm font-semibold text-white transition-transform focus:translate-y-0">Skip to main content</a>
    <header
      id="site-header"
      class="fixed inset-x-0 top-0 z-50 border-b border-brand-line bg-white/90 shadow-[0_12px_32px_-24px_rgb(0_0_0/0.25)] backdrop-blur-xl"
    >
      <nav aria-label="Primary" class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="flex items-center">
          <BrandLogo />
        </a>
        <div class="hidden items-center gap-6 text-sm font-medium text-neutral-700 lg:flex">
          <a class="transition-colors hover:text-brand-ember" href="/solutions" aria-current={isCurrent('/solutions') ? 'page' : undefined}>Solutions</a>
          <a class="transition-colors hover:text-brand-ember" href="/industries" aria-current={isCurrent('/industries') ? 'page' : undefined}>Industries</a>
          <a class="transition-colors hover:text-brand-ember" href="/case-studies" aria-current={isCurrent('/case-studies') ? 'page' : undefined}>Case Studies</a>
          <a class="transition-colors hover:text-brand-ember" href="/about" aria-current={isCurrent('/about') ? 'page' : undefined}>About</a>
          <a class="transition-colors hover:text-brand-ember" href="/investors" aria-current={isCurrent('/investors') ? 'page' : undefined}>Investors</a>
        </div>
        <div class="flex items-center gap-3">
          <a
            href="/contact"
            class="hidden rounded-full bg-brand-ink px-5 py-2.5 text-sm font-semibold text-white transition-all duration-200 hover:-translate-y-px hover:bg-brand-ember active:scale-[0.98] sm:inline-flex"
          >
            Tell us the problem
          </a>
          <button
            id="menu-btn"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="grid size-10 place-items-center rounded-full border border-brand-line text-sm font-semibold lg:hidden min-h-[44px] min-w-[44px]"
          >
            <span id="menu-label">Menu</span>
          </button>
        </div>
      </nav>
      <div
        id="mobile-menu"
        class="overflow-hidden border-t border-brand-line bg-white transition-[max-height,opacity] duration-300 ease-crisp lg:hidden"
        style="max-height: 0; opacity: 0;"
        aria-hidden="true"
        inert
      >
        <nav aria-label="Mobile" class="space-y-1 px-4 py-4 text-[15px] font-medium">
          <a class="block rounded-lg px-3 py-2.5 hover:bg-brand-mist" href="/solutions">Solutions</a>
          <a class="block rounded-lg px-3 py-2.5 hover:bg-brand-mist" href="/industries">Industries</a>
          <a class="block rounded-lg px-3 py-2.5 hover:bg-brand-mist" href="/case-studies">Case Studies</a>
          <a class="block rounded-lg px-3 py-2.5 hover:bg-brand-mist" href="/about">About</a>
          <a class="block rounded-lg px-3 py-2.5 hover:bg-brand-mist" href="/investors">Investors</a>
          <a
            class="mt-2 block rounded-full bg-brand-ink px-5 py-3 text-center text-sm font-semibold text-white transition-all duration-200 active:scale-[0.98]"
            href="/contact"
          >
            Tell us the problem
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="overflow-hidden border-t border-brand-line bg-brand-mist">
      <div class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 sm:pt-20">
        <div class="grid gap-10 md:grid-cols-12">
          <div class="md:col-span-4">
            <p class="flex items-center">
              <BrandLogo />
            </p>
            <p class="mt-4 max-w-xs text-sm leading-relaxed text-neutral-600">
              Hardware &amp; Software House customizing ecosystems to client requirements —
              especially real-time data transfer in harsh environments.
            </p>
            <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs font-medium text-neutral-600">
              {COMPANY.socials.map((s) => (
                <li><a class="transition-colors hover:text-brand-ember" href={s.href}>{s.label} ↗</a></li>
              ))}
            </ul>
          </div>
          <nav aria-label="Solutions" class="md:col-span-2">
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-neutral-600">Solutions</p>
            <ul class="mt-4 space-y-2.5 text-sm font-medium">
              <li><a class="transition-colors hover:text-brand-ember" href="/solutions/mission-critical-telemetry">Mission-Critical Telemetry</a></li>
              <li><a class="transition-colors hover:text-brand-ember" href="/solutions/industrial-iot-gateways">Industrial IoT &amp; Gateways</a></li>
              <li><a class="transition-colors hover:text-brand-ember" href="/solutions/smart-product-turnkey">Smart Product Turnkey</a></li>
              <li><a class="transition-colors hover:text-brand-ember" href="/solutions/edge-ai-vision">Edge AI &amp; Vision</a></li>
            </ul>
          </nav>
          <nav aria-label="Company" class="md:col-span-2">
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-neutral-600">Company</p>
            <ul class="mt-4 space-y-2.5 text-sm font-medium">
              <li><a class="transition-colors hover:text-brand-ember" href="/case-studies">Case Studies</a></li>
              <li><a class="transition-colors hover:text-brand-ember" href="/industries">Industries</a></li>
              <li><a class="transition-colors hover:text-brand-ember" href="/about">About</a></li>
              <li><a class="transition-colors hover:text-brand-ember" href="/investors">Investors</a></li>
              <li><a class="transition-colors hover:text-brand-ember" href="/contact">Contact</a></li>
            </ul>
          </nav>
          <div class="md:col-span-4">
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-neutral-600">Get in touch</p>
            <address class="mt-4 space-y-1.5 font-mono text-[13px] not-italic leading-relaxed text-neutral-700">
              <p>{COMPANY.address}</p>
              <p><a class="transition-colors hover:text-brand-ember" href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></p>
              <p><a class="transition-colors hover:text-brand-ember" href={COMPANY.phoneHref}>{COMPANY.phone}</a></p>
              <p>LINE <a class="transition-colors hover:text-brand-ember" href={COMPANY.lineUrl}>{COMPANY.lineId}</a></p>
              <p class="text-neutral-600">{COMPANY.hours}</p>
            </address>
          </div>
        </div>
      </div>
      <div class="border-t border-brand-line bg-brand-mist">
        <p class="mx-auto max-w-7xl px-4 py-5 font-mono text-[11px] text-neutral-600 sm:px-6">© 2026 Embedded Linux Group Co., Ltd. — All rights reserved.</p>
      </div>
    </footer>

    <script is:inline>
      // Mobile menu: smooth height + fade transition (respects reduced-motion).
      (function () {
        var menuBtn = document.getElementById('menu-btn');
        var mobileMenu = document.getElementById('mobile-menu');
        var menuLabel = document.getElementById('menu-label');
        if (!menuBtn || !mobileMenu) return;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var open = false;
        var setOpen = function (isOpen) {
          open = isOpen;
          menuBtn.setAttribute('aria-expanded', String(isOpen));
          if (menuLabel) menuLabel.textContent = isOpen ? 'Close' : 'Menu';
          mobileMenu.setAttribute('aria-hidden', String(!isOpen));
          mobileMenu.inert = !isOpen;
          if (reduced) {
            mobileMenu.style.maxHeight = isOpen ? '480px' : '0';
            mobileMenu.style.opacity = isOpen ? '1' : '0';
            return;
          }
          if (isOpen) {
            mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
            mobileMenu.style.opacity = '1';
          } else {
            mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
            // Force reflow so the collapse animates from current height.
            void mobileMenu.offsetHeight;
            mobileMenu.style.maxHeight = '0';
            mobileMenu.style.opacity = '0';
          }
        };
        menuBtn.addEventListener('click', function () {
          setOpen(!open);
        });
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && open) {
            setOpen(false);
            menuBtn.focus();
          }
        });
        window.addEventListener('resize', function () {
          if (window.innerWidth >= 1024 && open) setOpen(false);
        });
        mobileMenu.addEventListener('transitionend', function (e) {
          if (e.propertyName === 'max-height' && open) {
            mobileMenu.style.maxHeight = '480px';
          }
        });
      })();
    </script>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);
      const media = gsap.matchMedia();
      media.add('(prefers-reduced-motion: no-preference)', () => {
        const sections = gsap.utils.toArray<HTMLElement>('main > section:not(#capability-system):not(:first-child)');
        sections.forEach((section) => {
          const heading = section.querySelector('h2');
          const items = Array.from(section.querySelectorAll<HTMLElement>('[data-motion-item], article, figure, ol > li, ul > li'))
            .filter((item) => !item.closest('#capability-system'))
            .slice(0, 8);
          if (heading) gsap.from(heading, { y: 14, autoAlpha: 0, duration: 0.55, ease: 'power2.out', scrollTrigger: { trigger: section, start: 'top 88%', once: true } });
          if (items.length) gsap.from(items, { y: 10, autoAlpha: 0, duration: 0.4, stagger: 0.045, ease: 'power1.out', scrollTrigger: { trigger: section, start: 'top 82%', once: true } });
        });
      });
    </script>

  </body>
</html>
