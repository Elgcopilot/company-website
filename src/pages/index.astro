---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ClientLogos from '@/components/ClientLogos.astro';
import HowElgWorks from '@/components/HowElgWorks.astro';
import Capabilities from '@/components/Capabilities.astro';
import Evidence from '@/components/Evidence.astro';
import FinalCta from '@/components/FinalCta.astro';

const all = await getCollection('case-studies');
const slugs = ['isuzu-motorsport-telemetry', 'lg-smart-laundry-iot', 'kmitl-edge-ai-agri-board'];
const studies = slugs.map((slug) => all.find((study) => study.slug === slug)).filter((study): study is NonNullable<typeof study> => Boolean(study));
---

<BaseLayout title="Embedded Systems for Difficult Real-World Problems" description="ELG designs hardware, embedded software, connectivity, cloud services, and interfaces as one reliable system.">
  <Hero />
  <ClientLogos />
  <HowElgWorks />
  <Capabilities />
  <Evidence studies={studies} />
  <FinalCta />
</BaseLayout>
