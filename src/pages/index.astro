---
/**
 * index — ELG homepage (production).
 * Editorial hero with production-grade telemetry visual → client logos →
 * proof band → realities → capabilities → field evidence →
 * scroll-driven stack explode → final CTA.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ClientLogos from '@/components/ClientLogos.astro';
import ProofBand from '@/components/ProofBand.astro';
import Realities from '@/components/Realities.astro';
import Capabilities from '@/components/Capabilities.astro';
import Evidence from '@/components/Evidence.astro';
import StackExplode from '@/components/StackExplode.astro';
import FinalCta from '@/components/FinalCta.astro';

const all = await getCollection('case-studies');
const bySlug = (slug: string) => all.find((s) => s.slug === slug);
const feature = bySlug('isuzu-motorsport-telemetry') ?? all.find((s) => s.data.isFeatured) ?? all[0];
const supporting = ['pt-racing-emission-telemetry', 'lg-smart-laundry-iot']
  .map(bySlug)
  .filter((s) => s !== undefined && s.slug !== feature.slug)
  .slice(0, 2) as Exclude<ReturnType<typeof bySlug>, undefined>[];
---

<BaseLayout
  title="Hardware & Software House for Real-Time Systems in Harsh Environments"
  description="ELG customizes end-to-end ecosystems to client requirements — especially real-time data transfer systems that keep working in harsh environments."
>
  <Hero />
  <ClientLogos />
  <ProofBand />
  <Realities />
  <Capabilities />
  <Evidence feature={feature} supporting={supporting} />
  <StackExplode />
  <FinalCta />
</BaseLayout>
