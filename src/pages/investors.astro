---
import BaseLayout from '@/layouts/BaseLayout.astro';
import InvestorAccessForm from '@/components/react/InvestorAccessForm';
import { COMPANY } from '@/data/company';
---

<BaseLayout
  title="Private Investor Access"
  description="Request private access to ELG's investor pitch, roadmap, and current initiatives. Materials are reviewed and shared individually."
  noindex
>
  <section class="border-b border-brand-line bg-white">
    <div class="mx-auto max-w-7xl px-4 pb-16 pt-28 sm:px-6 sm:pb-20">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-ember">Private investor access</p>
      <h1 class="mt-5 max-w-5xl text-balance text-5xl font-semibold leading-[0.98] tracking-[-0.04em] text-brand-ink sm:text-7xl">Investor materials are shared privately.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-600">Request access to ELG’s pitch deck, roadmap, and current initiatives. We review each request before sharing confidential material.</p>
    </div>
  </section>

  <section class="bg-brand-mist">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-3">
      <div class="lg:col-span-2"><InvestorAccessForm client:visible /></div>
      <aside class="space-y-5">
        <div class="rounded-xl border border-brand-line bg-white p-6">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-neutral-600">What happens next</h2>
          <ol class="mt-4 space-y-4 text-sm leading-relaxed text-neutral-600">
            <li class="flex gap-3"><span class="font-mono font-bold text-brand-ember">01</span><span>ELG reviews your identity and investment context.</span></li>
            <li class="flex gap-3"><span class="font-mono font-bold text-brand-ember">02</span><span>We arrange a short introductory conversation if there is a fit.</span></li>
            <li class="flex gap-3"><span class="font-mono font-bold text-brand-ember">03</span><span>Approved materials are delivered through a controlled private channel.</span></li>
          </ol>
        </div>
        <div class="rounded-xl bg-brand-ink p-6 text-white">
          <h2 class="text-lg font-semibold">Privacy by default.</h2>
          <p class="mt-2 text-sm leading-relaxed text-neutral-400">The public website contains no pitch deck, financial information, private roadmap, or direct document URL.</p>
        </div>
        <div class="rounded-xl border border-brand-line bg-white p-6">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-neutral-600">Direct enquiry</h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-600">Prefer email? Include your name, organization, role, and investment focus.</p>
          <a href={`mailto:${COMPANY.email}?subject=Private%20investor%20access%20request`} class="mt-4 inline-flex min-h-11 items-center font-semibold text-brand-ember underline-offset-4 hover:underline">{COMPANY.email}</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
