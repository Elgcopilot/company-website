---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import CaseStudyFilters from '@/components/react/CaseStudyFilters';

const studies = (await getCollection('case-studies'))
  .sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
const items = studies.map((s) => ({
  slug: s.slug,
  title: s.data.title,
  subtitle: s.data.subtitle,
  industry: s.data.industry,
  projectType: s.data.projectType,
  clientPartner: s.data.clientPartner,
  status: s.data.status,
  featuredImage: s.data.featuredImage,
  isPlaceholderImage: s.data.isPlaceholderImage,
  environmentConstraints: s.data.environmentConstraints,
}));
---

<BaseLayout
  title="Case Studies — Field Evidence from Harsh Environments"
  description="12 field-deployed ELG ecosystems: motorsport telemetry, industrial IoT, smart products and edge AI. Every metric flagged verified or pending validation."
>
  <PageHero
    eyebrow="Field Evidence"
    title="Proven where failure is not an option."
    lede="12 deployed ecosystems across motorsport, energy, enterprise, agriculture, buildings, education and events. Filter by industry and project type — every claim links to its evidence."
  />
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
      <CaseStudyFilters client:load items={items} />
      <noscript>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {studies.map((s) => (
            <article class="rounded-2xl border border-brand-line bg-white p-6">
              <h3 class="font-semibold tracking-tight"><a href={`/case-studies/${s.slug}`}>{s.data.title}</a></h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-600">{s.data.subtitle}</p>
            </article>
          ))}
        </div>
      </noscript>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
