---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Metric from '@/components/Metric.astro';
import { COMPANY } from '@/data/company';
---

<BaseLayout
  title="About — Hardware & Software House"
  description="ELG customizes end-to-end ecosystems to client requirements, specializing in real-time data transfer in harsh environments. Bangkok-based, MOQ from 5 units."
>
  <PageHero
    eyebrow="About ELG"
    title="A Hardware & Software House for systems that must not fail."
    lede="We customize end-to-end ecosystems to exact client requirements — especially real-time data transfer systems operating in harsh environments."
  />
  <section class="bg-white">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-3">
      <article class="rounded-xl border border-brand-line p-6 sm:p-8 lg:col-span-2" data-reveal>
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-neutral-500">Who we are</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-brand-ink sm:text-3xl">Evidence, not claims.</h2>
        <p class="mt-3 leading-relaxed text-neutral-600">
          Every ELG engagement combines the same six building blocks — custom hardware,
          RTOS firmware, embedded Linux, IoT connectivity, edge AI and cloud backends —
          into one ecosystem specified for your operating reality. Motorsport taught us
          what zero-failure engineering costs; industrial, enterprise and agriculture
          clients spend less because that lesson is already paid for.
        </p>
        <p class="mt-3 leading-relaxed text-neutral-600">
          Pilot runs start at just 5 units. Per-client internals — chips, BOMs, protocol
          specifics — stay under NDA. What we publish is overview architecture and
          field evidence you can verify.
        </p>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <Metric label="Prototype entry" value="MOQ 5" subtext="Pilot runs for startups and trials." verified />
          <Metric label="Engineering reply" value="1 business day" subtext="Direct line to the build team." verified />
          <Metric label="Race-event uptime" value="100%" subtext="Zero-failure operation during competition." />
        </div>
      </article>
      <aside class="space-y-5" data-reveal data-reveal-delay="0.1">
        <div class="rounded-xl border border-brand-line bg-brand-mist p-6">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-neutral-500">Company</h2>
          <p class="mt-3 text-sm font-semibold">{COMPANY.name} Co., Ltd.</p>
          <address class="mt-2 space-y-1 text-sm not-italic text-neutral-600">
            <p>{COMPANY.address}</p>
            <p>{COMPANY.hours}</p>
          </address>
        </div>
        <div class="rounded-xl bg-brand-ink p-6 text-white">
          <h2 class="text-sm font-bold">Meet the build team.</h2>
          <p class="mt-1 text-sm text-neutral-400">One conversation with an engineer beats ten sales decks.</p>
          <a href="/contact" class="mt-4 block rounded-full bg-white px-4 py-2.5 text-center text-sm font-semibold text-brand-ink transition-all duration-200 hover:-translate-y-px active:scale-[0.98]">
            Talk to our Team
          </a>
        </div>
      </aside>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
