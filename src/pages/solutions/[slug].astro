---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import Prose from '@/components/Prose.astro';
import CtaBand from '@/components/CtaBand.astro';
import { CAPABILITY_MODULES } from '@/data/company';

export async function getStaticPaths() {
  const items = await getCollection('solutions');
  return items.map((s) => ({ params: { slug: s.slug }, props: { slug: s.slug } }));
}

const { slug } = Astro.props;
const all = await getCollection('solutions');
const entry = all.find((s) => s.slug === slug)!;
const cases = await getCollection('case-studies');
const { Content } = await entry.render();
const d = entry.data;
const modName = (m: string) => CAPABILITY_MODULES.find((c) => c.slug === m)?.name ?? m;
const proof = cases
  .filter((c) => c.data.capabilityModules.some((m) => d.capabilityModules.includes(m)))
  .slice(0, 3);
---

<BaseLayout title={d.title} description={d.tagline}>
  <!-- Editorial package hero with mono spec row -->
  <section class="border-b border-brand-line bg-white">
    <div class="mx-auto max-w-7xl px-4 pb-10 pt-24 sm:px-6 sm:pb-14 sm:pt-28">
      <p class="flex flex-wrap items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.18em]">
        <a href="/solutions" class="text-brand-ember hover:underline">Solutions</a>
        <span class="text-neutral-300" aria-hidden="true">/</span>
        <span class="text-neutral-500">{d.packageType}</span>
      </p>
      <h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-[1.02] tracking-[-0.03em] text-brand-ink sm:text-5xl md:text-6xl">{d.title}</h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-neutral-600 sm:text-lg">{d.tagline}</p>
      <div class="mt-7 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-brand-line pt-5">
        <div class="flex max-w-md flex-wrap gap-2">
          {d.capabilityModules.map((m) => (
            <span class="rounded-full bg-brand-paper px-3 py-1.5 text-[11px] font-semibold text-neutral-700 ring-1 ring-brand-line">{modName(m)}</span>
          ))}
        </div>
        {d.metrics[0] && (
          <p class="font-mono text-sm font-bold text-brand-ink">
            {d.metrics[0].value} <span class="text-[11px] font-medium uppercase tracking-[0.16em] text-neutral-500">{d.metrics[0].label}</span>
          </p>
        )}
      </div>
    </div>
  </section>
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-3">
        <article class="lg:col-span-2" data-reveal>
          <Prose><Content /></Prose>
        </article>
        <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start" data-reveal data-reveal-delay="0.1">
          <div class="rounded-2xl bg-brand-ink p-6 text-white sm:p-7">
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-neutral-400">Start here</p>
            <h2 class="mt-3 text-xl font-semibold tracking-[-0.02em]">Scope this package to your site.</h2>
            <p class="mt-2 text-sm leading-relaxed text-neutral-400">Bring the signal list and the operating reality — we return a pilot proposal from MOQ 5.</p>
            <a href="/contact" class="group mt-6 flex items-center justify-center gap-2 rounded-full bg-white px-4 py-3 text-sm font-semibold text-brand-ink transition-all duration-200 hover:-translate-y-px active:scale-[0.98]">
              Talk to our Team
              <span aria-hidden="true" class="grid size-5 place-items-center rounded-full bg-brand-orange text-xs leading-none text-white transition-transform duration-200 group-hover:translate-x-0.5">→</span>
            </a>
          </div>
          {d.metrics.length > 1 && (
            <div class="rounded-2xl border border-brand-line bg-brand-paper p-6">
              <h2 class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-neutral-500">Package signals</h2>
              <dl class="mt-3 space-y-3 font-mono">
                {d.metrics.slice(1).map((m) => (
                  <div class="border-t border-brand-line pt-3 first:border-t-0 first:pt-0">
                    <dd class="text-base font-bold tracking-tight text-brand-ink">{m.value}{!m.verified && <span class="text-brand-orange" aria-hidden="true">*</span>}</dd>
                    <dt class="mt-0.5 text-[10px] uppercase tracking-[0.16em] text-neutral-500">{m.label}{m.subtext ? ` — ${m.subtext}` : ''}</dt>
                  </div>
                ))}
              </dl>
              <p class="mt-3 font-mono text-[10px] text-neutral-400">* Pending validation — details under NDA.</p>
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>
  <section class="border-t border-brand-line bg-brand-paper">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <h2 class="text-2xl font-semibold tracking-[-0.02em] text-brand-ink sm:text-3xl">Proof it works</h2>
        <a href="/case-studies" class="text-sm font-semibold text-brand-ember hover:underline">All case studies →</a>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {proof.map((s) => (
          <CaseStudyCard slug={s.slug} title={s.data.title} subtitle={s.data.subtitle} industry={s.data.industry} projectType={s.data.projectType} clientPartner={s.data.clientPartner} status={s.data.status} featuredImage={s.data.featuredImage} isPlaceholderImage={s.data.isPlaceholderImage} environmentConstraints={s.data.environmentConstraints} />
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
