---
/**
 * CaseStudyCard — static `.astro` card (zero JS).
 * Evidence-first: unverified metrics are never stated as fact;
 * placeholder images carry an explicit flag per Brand.md §4.
 */
interface Props {
  slug: string;
  title: string;
  subtitle: string;
  industry: string;
  projectType: string;
  clientPartner?: string;
  status: string;
  featuredImage: string;
  isPlaceholderImage?: boolean;
  environmentConstraints: string[];
}

const {
  slug,
  title,
  subtitle,
  industry,
  projectType,
  clientPartner,
  status,
  featuredImage,
  isPlaceholderImage = false,
  environmentConstraints,
} = Astro.props;
---

<article class="group flex flex-col overflow-hidden rounded-xl border border-brand-line bg-white transition-all duration-200 ease-crisp hover:-translate-y-1 hover:border-brand-orange/40 hover:shadow-lg">
  <a href={`/case-studies/${slug}`} class="flex h-full flex-col" aria-label={`Read case study: ${title}`}>
    <div class="relative aspect-[16/9] overflow-hidden bg-brand-mist">
      <img
        src={featuredImage}
        alt={title}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 ease-crisp group-hover:scale-105"
      />
      {isPlaceholderImage && (
        <span class="absolute left-3 top-3 rounded-md bg-brand-ink/85 px-2 py-1 text-[11px] font-medium text-white">
          [Placeholder Asset]
        </span>
      )}
      {clientPartner && (
        <span class="absolute right-3 top-3 rounded-md bg-white/90 px-2 py-1 font-mono text-[11px] font-semibold text-brand-ink backdrop-blur">
          {clientPartner}
        </span>
      )}
    </div>
    <div class="flex flex-1 flex-col p-5">
      <div class="flex flex-wrap gap-2 text-[11px] font-semibold uppercase tracking-widest">
        <span class="rounded-full bg-brand-mist px-2 py-1 text-neutral-600">{industry}</span>
        <span class="rounded-full bg-brand-orange/10 px-2 py-1 text-brand-ember">{projectType}</span>
      </div>
      <h3 class="mt-3 font-semibold leading-snug tracking-tight group-hover:text-brand-ember">{title}</h3>
      <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-neutral-600">{subtitle}</p>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {environmentConstraints.slice(0, 2).map((c) => (
          <span class="rounded-md border border-brand-line px-2 py-1 text-[11px] text-neutral-500">{c}</span>
        ))}
      </div>
      <p class="mt-4 flex items-center justify-between border-t border-brand-line pt-3 text-xs">
        <span class="font-mono font-semibold text-neutral-500">{status}</span>
        <span class="font-semibold text-brand-ember">Read evidence →</span>
      </p>
    </div>
  </a>
</article>
