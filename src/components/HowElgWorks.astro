---
import StepIcon, { type StepIconName } from './StepIcon.astro';

const STEPS: { number: string; title: string; text: string; icon: StepIconName }[] = [
  { number: '01', title: 'Understand', text: 'See the people, process, equipment, data, and constraints.', icon: 'layers' },
  { number: '02', title: 'Find', text: 'Identify the bottleneck worth solving.', icon: 'gauge' },
  { number: '03', title: 'Design', text: 'Define the smallest complete system that creates value.', icon: 'box' },
  { number: '04', title: 'Build', text: 'Engineer hardware and software as one system.', icon: 'cog' },
  { number: '05', title: 'Prove', text: 'Deploy, measure, learn, and strengthen the capability.', icon: 'shield' },
];
---

<section id="how-elg-works" class="overflow-hidden bg-brand-coal text-white" aria-labelledby="how-title">
  <div class="how-stage">
    <div class="how-pinned mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
      <div class="max-w-3xl">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-orange">How ELG works</p>
        <h2 id="how-title" class="mt-4 text-balance text-4xl font-semibold leading-[1.03] tracking-[-0.035em] sm:text-6xl">Technology starts with the problem, not the tool.</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-400">We study the whole system first, then engineer only what the outcome requires.</p>
      </div>

      <div class="mt-12 flex items-center justify-between gap-4 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-neutral-400">
        <span>Five steps, one process</span>
        <span class="hidden items-center gap-2 md:flex"><span class="size-1.5 rounded-full bg-brand-orange"></span> Problem to proven capability</span>
      </div>

      <ol class="process-puzzle mt-6 grid gap-3 md:grid-cols-5 md:gap-0" aria-label="ELG five-step engineering process">
        {STEPS.map((step, index) => (
          <li data-how-piece style={`--i:${index}`} class:list={['process-piece relative min-h-52 border border-white/15 bg-brand-coal p-6', index === 0 && 'md:rounded-l-xl', index === STEPS.length - 1 && 'md:rounded-r-xl']}>
            <div class="relative z-10 flex h-full flex-col">
              <p class="font-mono text-[10px] font-bold tracking-[0.16em] text-brand-orange">{step.number}</p>
              <div data-how-icon data-icon-kind={step.icon} class="step-icon mt-6 grid size-11 shrink-0 place-items-center rounded-lg border border-white/15 bg-white/5 text-brand-orange" aria-hidden="true">
                <StepIcon name={step.icon} size={22} />
              </div>
              <h3 class="mt-4 text-xl font-semibold tracking-tight">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-400">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="mt-12 flex flex-col gap-6 border-l-2 border-brand-orange pl-6 sm:flex-row sm:items-end sm:justify-between">
        <p class="max-w-3xl text-2xl font-semibold leading-snug tracking-[-0.025em] sm:text-3xl">One problem creates a solution. Repeated solutions create capability.</p>
        <p class="shrink-0 font-mono text-[11px] uppercase tracking-[0.16em] text-neutral-400">Learn. Reuse. Improve.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .process-piece {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 250ms ease,
      background-color 250ms ease;
    transition-delay: calc(var(--i, 0) * 80ms), calc(var(--i, 0) * 80ms), 0ms, 0ms;
  }
  .how-assembled .process-piece {
    opacity: 1;
    transform: none;
  }
  .process-piece:hover {
    z-index: 20;
    transform: translateY(-4px);
    border-color: rgb(217 95 22 / 0.75);
    background: #171713;
  }
  .step-icon {
    transition: border-color 220ms ease-out, background-color 220ms ease-out;
  }
  .process-piece:hover .step-icon,
  .process-piece:focus-within .step-icon {
    border-color: rgb(217 95 22 / 0.65);
    background: rgb(217 95 22 / 0.09);
  }
  .step-icon :global(svg),
  .step-icon :global(svg *) {
    transform-box: fill-box;
    transform-origin: center;
  }
  /* Layers (Understand): lower layers lift apart, then settle — stiffness 100, damping 14. */
  .step-icon.is-active[data-icon-kind='layers'] :global(svg path:nth-child(2)) {
    animation: repo-layers-lift-9 620ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .step-icon.is-active[data-icon-kind='layers'] :global(svg path:nth-child(3)) {
    animation: repo-layers-lift-5 620ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  /* Gauge (Find): needle sweeps 72° with spring overshoot — stiffness 160, damping 17. */
  .step-icon.is-active[data-icon-kind='gauge'] :global(svg path:first-child) {
    animation: repo-gauge-sweep 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: 12px 14px;
  }
  /* Box (Design): all edges redraw — pathLength 0→1 with fade, 400ms. */
  .step-icon.is-active[data-icon-kind='box'] :global(svg path) {
    stroke-dasharray: 1;
    animation: repo-stroke-draw 420ms ease-out;
  }
  .step-icon.is-active[data-icon-kind='box'] :global(svg path:nth-child(2)) {
    animation-delay: 60ms;
  }
  .step-icon.is-active[data-icon-kind='box'] :global(svg path:nth-child(3)) {
    animation-delay: 120ms;
  }
  /* Cog (Build): full 180° spring turn — stiffness 50, damping 10. */
  .step-icon.is-active[data-icon-kind='cog'] :global(svg) {
    animation: repo-cog-turn 640ms cubic-bezier(0.34, 1.3, 0.64, 1);
  }
  /* Shield (Prove): checkmark draws and pops — pathLength 0→1, scale 0.5→1. */
  .step-icon.is-active[data-icon-kind='shield'] :global(svg path:last-child) {
    stroke-dasharray: 1;
    transform-origin: 13px 12px;
    animation: repo-check-pop 440ms ease-out;
  }
  @keyframes repo-layers-lift-9 {
    0% { transform: translateY(0); }
    45% { transform: translateY(-9px); }
    100% { transform: translateY(0); }
  }
  @keyframes repo-layers-lift-5 {
    0% { transform: translateY(0); }
    45% { transform: translateY(-5px); }
    100% { transform: translateY(0); }
  }
  @keyframes repo-gauge-sweep {
    0% { transform: rotate(0) translate(0, 0); }
    55% { transform: rotate(72deg) translate(0.5px, 3px); }
    100% { transform: rotate(0) translate(0, 0); }
  }
  @keyframes repo-stroke-draw {
    from { stroke-dashoffset: 1; opacity: 0; }
    to { stroke-dashoffset: 0; opacity: 1; }
  }
  @keyframes repo-cog-turn {
    from { transform: rotate(0); }
    to { transform: rotate(180deg); }
  }
  @keyframes repo-check-pop {
    0% { stroke-dashoffset: 1; opacity: 0; transform: scale(0.5); }
    100% { stroke-dashoffset: 0; opacity: 1; transform: scale(1); }
  }
  @media (min-width: 768px) {
    .process-piece { margin: -0.5px; }
    .process-piece:not(:last-child)::after {
      content: '';
      position: absolute;
      z-index: 15;
      top: calc(50% - 14px);
      right: -14px;
      width: 28px;
      height: 28px;
      border: 1px solid rgb(255 255 255 / 0.15);
      border-left: 0;
      border-radius: 0 999px 999px 0;
      background: #11110f;
    }
  }
  @media (min-width: 1024px) {
    .how-pinned {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 2rem;
      padding-bottom: 2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .process-piece {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .step-icon :global(svg),
    .step-icon :global(svg *) {
      animation: none !important;
    }
  }
</style>

<script>
  const section = document.getElementById('how-elg-works');
  if (section) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      section.classList.add('how-assembled');
    } else {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            section.classList.add('how-assembled');
            observer.disconnect();
          }
        },
        { threshold: 0.2 },
      );
      observer.observe(section);

      const icons = section.querySelectorAll<HTMLElement>('[data-how-icon]');
      const playIcon = (icon: HTMLElement) => {
        icon.classList.remove('is-active');
        void icon.offsetWidth;
        icon.classList.add('is-active');
      };

      // Each icon plays once as its step enters, then replays on pointer focus.
      const iconObserver = new IntersectionObserver(
        (entries) => entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          playIcon(entry.target as HTMLElement);
          iconObserver.unobserve(entry.target);
        }),
        { threshold: 0.7 },
      );
      icons.forEach((icon) => {
        iconObserver.observe(icon);
        icon.closest('[data-how-piece]')?.addEventListener('pointerenter', () => playIcon(icon));
      });
    }
  }
</script>
