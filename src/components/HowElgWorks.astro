---
const STEPS = [
  { number: '01', title: 'Understand', text: 'See the people, process, equipment, data, and constraints.' },
  { number: '02', title: 'Find', text: 'Identify the bottleneck worth solving.' },
  { number: '03', title: 'Design', text: 'Define the smallest complete system that creates value.' },
  { number: '04', title: 'Build', text: 'Engineer hardware and software as one system.' },
  { number: '05', title: 'Prove', text: 'Deploy, measure, learn, and strengthen the capability.' },
];
---

<section id="how-elg-works" class="overflow-hidden bg-brand-coal text-white" aria-labelledby="how-title">
  <div class="how-stage">
    <div class="how-pinned mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
      <div class="max-w-3xl">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-orange">How ELG works</p>
        <h2 id="how-title" class="mt-4 text-balance text-4xl font-semibold leading-[1.03] tracking-[-0.035em] sm:text-6xl">Technology starts with the problem, not the tool.</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-400">We study the whole system first, then engineer only what the outcome requires.</p>
      </div>

      <div class="mt-12 flex items-center justify-between gap-4 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-neutral-400">
        <span data-how-state>Scroll to connect the process</span>
        <span class="hidden items-center gap-2 md:flex"><span class="size-1.5 rounded-full bg-brand-orange"></span> Problem to proven capability</span>
      </div>
      <div class="how-progress mt-4" aria-hidden="true"><span data-how-progress></span></div>

      <ol class="process-puzzle mt-6 grid gap-3 md:grid-cols-5 md:gap-0" aria-label="ELG five-step engineering process">
        {STEPS.map((step, index) => (
          <li data-how-piece class:list={['process-piece relative min-h-52 border border-white/15 bg-brand-coal p-6', index === 0 && 'md:rounded-l-xl', index === STEPS.length - 1 && 'md:rounded-r-xl']}>
            <div class="relative z-10 flex h-full flex-col">
              <p class="font-mono text-[10px] font-bold tracking-[0.16em] text-brand-orange">{step.number}</p>
              <h3 class="mt-8 text-xl font-semibold tracking-tight">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-400">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="mt-12 flex flex-col gap-6 border-l-2 border-brand-orange pl-6 sm:flex-row sm:items-end sm:justify-between">
        <p class="max-w-3xl text-2xl font-semibold leading-snug tracking-[-0.025em] sm:text-3xl">One problem creates a solution. Repeated solutions create capability.</p>
        <p class="shrink-0 font-mono text-[11px] uppercase tracking-[0.16em] text-neutral-400">Learn. Reuse. Improve.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .how-progress {
    height: 2px;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.15);
  }
  .how-progress > span {
    display: block;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left;
    border-radius: inherit;
    background: #d95f16;
  }
  .process-piece {
    transition: border-color 250ms ease, background-color 250ms ease, transform 250ms ease;
  }
  .process-piece:hover {
    z-index: 20;
    transform: translateY(-4px);
    border-color: rgb(217 95 22 / 0.75);
    background: #171713;
  }
  @media (min-width: 768px) {
    .process-piece { margin: -0.5px; }
    .process-piece:not(:last-child)::after {
      content: '';
      position: absolute;
      z-index: 15;
      top: calc(50% - 14px);
      right: -14px;
      width: 28px;
      height: 28px;
      border: 1px solid rgb(255 255 255 / 0.15);
      border-left: 0;
      border-radius: 0 999px 999px 0;
      background: #11110f;
    }
  }
  @media (min-width: 1024px) {
    .how-pinned {
      display: flex;
      min-height: calc(100vh - 64px);
      flex-direction: column;
      justify-content: center;
      padding-top: 2rem;
      padding-bottom: 2rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const section = document.getElementById('how-elg-works');
  if (section) {
    const media = gsap.matchMedia();
    const createAssembly = (pinned: boolean) => {
      const pieces = section.querySelectorAll('[data-how-piece]');
      const progress = section.querySelector('[data-how-progress]');
      const state = section.querySelector('[data-how-state]');
      const pinnedEl = section.querySelector('.how-pinned');
      const offsets = pinned ? [-420, -210, 0, 210, 420] : [-90, -45, 0, 45, 90];
      const timeline = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: pinned ? 'top top+=64' : 'top 88%',
          end: pinned ? '+=1100' : 'center 42%',
          pin: pinned ? pinnedEl : false,
          pinSpacing: pinned,
          anticipatePin: pinned ? 1 : 0,
          scrub: pinned ? 1.25 : 0.8,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            if (state) state.textContent = self.progress >= 0.86 ? 'Connected: process complete' : 'Scroll to connect the process';
          },
        },
      });
      timeline.fromTo(
        pieces,
        { x: (index) => offsets[index] ?? 0, rotation: (index) => index < 2 ? -3 : index > 2 ? 3 : 0, scale: (index) => index === 2 ? 0.94 : 0.88 },
        { x: 0, rotation: 0, scale: 1, duration: 0.86, ease: 'none' },
      );
      if (progress) timeline.fromTo(progress, { scaleX: 0 }, { scaleX: 1, duration: 0.86, ease: 'none' }, 0);
      timeline.to({}, { duration: 0.14 });
    };
    media.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => createAssembly(true));
    media.add('(max-width: 1023px) and (prefers-reduced-motion: no-preference)', () => createAssembly(false));
  }
</script>
