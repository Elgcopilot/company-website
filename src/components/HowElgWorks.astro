---
import Icon from './Icon.astro';
import type { IconName } from './icons';

const STEPS: { number: string; title: string; text: string; icon: IconName }[] = [
  { number: '01', title: 'Understand', text: 'See the people, process, equipment, data, and constraints.', icon: 'layers' },
  { number: '02', title: 'Find', text: 'Identify the bottleneck worth solving.', icon: 'gauge' },
  { number: '03', title: 'Design', text: 'Define the smallest complete system that creates value.', icon: 'box' },
  { number: '04', title: 'Build', text: 'Engineer hardware and software as one system.', icon: 'cog' },
  { number: '05', title: 'Prove', text: 'Deploy, measure, learn, and strengthen the capability.', icon: 'shield' },
];
---

<section id="how-elg-works" class="overflow-hidden bg-brand-coal text-white" aria-labelledby="how-title">
  <div class="how-stage">
    <div class="how-pinned mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
      <div class="max-w-3xl">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-orange">How ELG works</p>
        <h2 id="how-title" class="mt-4 text-balance text-4xl font-semibold leading-[1.03] tracking-[-0.035em] sm:text-6xl">Technology starts with the problem, not the tool.</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-400">We study the whole system first, then engineer only what the outcome requires.</p>
      </div>

      <div class="mt-12 flex items-center justify-between gap-4 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-neutral-400">
        <span>Five steps, one process</span>
        <span class="hidden items-center gap-2 md:flex"><span class="size-1.5 rounded-full bg-brand-orange"></span> Problem to proven capability</span>
      </div>

      <ol class="process-puzzle mt-6 grid gap-3 md:grid-cols-5 md:gap-0" aria-label="ELG five-step engineering process">
        {STEPS.map((step, index) => (
          <li data-how-piece style={`--i:${index}`} class:list={['process-piece relative min-h-52 border border-white/15 bg-brand-coal p-6', index === 0 && 'md:rounded-l-xl', index === STEPS.length - 1 && 'md:rounded-r-xl']}>
            <div class="relative z-10 flex h-full flex-col">
              <p class="font-mono text-[10px] font-bold tracking-[0.16em] text-brand-orange">{step.number}</p>
              <div data-how-icon class="mt-6 grid size-11 shrink-0 place-items-center rounded-lg border border-white/15 bg-white/5 text-brand-orange" aria-hidden="true">
                <Icon name={step.icon} size={22} />
              </div>
              <h3 class="mt-4 text-xl font-semibold tracking-tight">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-400">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="mt-12 flex flex-col gap-6 border-l-2 border-brand-orange pl-6 sm:flex-row sm:items-end sm:justify-between">
        <p class="max-w-3xl text-2xl font-semibold leading-snug tracking-[-0.025em] sm:text-3xl">One problem creates a solution. Repeated solutions create capability.</p>
        <p class="shrink-0 font-mono text-[11px] uppercase tracking-[0.16em] text-neutral-400">Learn. Reuse. Improve.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .process-piece {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 250ms ease,
      background-color 250ms ease;
    transition-delay: calc(var(--i, 0) * 80ms), calc(var(--i, 0) * 80ms), 0ms, 0ms;
  }
  .how-assembled .process-piece {
    opacity: 1;
    transform: none;
  }
  .process-piece:hover {
    z-index: 20;
    transform: translateY(-4px);
    border-color: rgb(217 95 22 / 0.75);
    background: #171713;
  }
  .process-piece:hover [data-how-icon] svg {
    animation: icon-nudge 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes icon-nudge {
    0% { transform: translateY(0) rotate(0); }
    35% { transform: translateY(-3px) rotate(-8deg); }
    70% { transform: translateY(1px) rotate(5deg); }
    100% { transform: translateY(0) rotate(0); }
  }
  @media (min-width: 768px) {
    .process-piece { margin: -0.5px; }
    .process-piece:not(:last-child)::after {
      content: '';
      position: absolute;
      z-index: 15;
      top: calc(50% - 14px);
      right: -14px;
      width: 28px;
      height: 28px;
      border: 1px solid rgb(255 255 255 / 0.15);
      border-left: 0;
      border-radius: 0 999px 999px 0;
      background: #11110f;
    }
  }
  @media (min-width: 1024px) {
    .how-pinned {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 2rem;
      padding-bottom: 2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .process-piece {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .process-piece:hover [data-how-icon] svg {
      animation: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const section = document.getElementById('how-elg-works');
  if (section) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      section.classList.add('how-assembled');
    } else {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            section.classList.add('how-assembled');
            observer.disconnect();
          }
        },
        { threshold: 0.2 },
      );
      observer.observe(section);

      // Scroll-linked icon micro-motion: icons drift and tilt gently
      // as the section travels through the viewport (transform only).
      const media = gsap.matchMedia();
      media.add('(prefers-reduced-motion: no-preference)', () => {
        const icons = section.querySelectorAll('[data-how-icon]');
        gsap.fromTo(
          icons,
          { y: 7, rotation: -5 },
          {
            y: -7,
            rotation: 5,
            ease: 'none',
            stagger: 0.03,
            scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 1.2 },
          },
        );
      });
    }
  }
</script>
