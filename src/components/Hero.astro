---
const STACK = [
  { id: 'hardware', label: 'Hardware', detail: 'Sense and control the physical system.' },
  { id: 'firmware', label: 'Firmware', detail: 'Respond predictably when timing matters.' },
  { id: 'embedded', label: 'Embedded', detail: 'Process locally and survive link outages.' },
  { id: 'connectivity', label: 'Connectivity', detail: 'Move information reliably across sites.' },
  { id: 'cloud', label: 'Cloud', detail: 'Unify live data, history, and alerts.' },
  { id: 'interface', label: 'Interface', detail: 'Help people understand and act.' },
];
---

<section class="relative overflow-hidden bg-white" aria-labelledby="home-title">
  <div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(to_right,rgb(17_17_17/0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgb(17_17_17/0.04)_1px,transparent_1px)] bg-[size:72px_72px] [mask-image:radial-gradient(ellipse_85%_75%_at_68%_40%,black,transparent_78%)]"></div>
  <div class="relative mx-auto grid min-h-[100dvh] max-w-7xl items-center gap-12 px-4 pb-16 pt-24 sm:px-6 sm:pt-28 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-6">
      <p data-hero-copy class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-neutral-600">Embedded systems for the real world</p>
      <h1 id="home-title" data-hero-copy class="mt-5 max-w-3xl text-balance text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-brand-ink sm:text-6xl lg:text-7xl">Understand the <span class="text-brand-ember">real problem.</span> Engineer the <span class="text-brand-ember">ecosystem.</span></h1>
      <p data-hero-copy class="mt-6 max-w-xl text-lg leading-relaxed text-neutral-600">ELG understands the operating problem first, then engineers every required layer as one working ecosystem.</p>
      <div data-hero-copy class="mt-8 flex flex-wrap gap-3">
        <a href="/contact" class="group inline-flex min-h-11 items-center gap-2 rounded-full bg-brand-ink px-7 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-px hover:bg-brand-ember active:scale-[0.98]">Tell us the problem <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span></a>
        <a href="/case-studies" class="inline-flex min-h-11 items-center rounded-full border border-brand-line bg-white px-7 py-3 text-sm font-semibold text-brand-ink transition duration-200 hover:-translate-y-px hover:border-brand-ink active:scale-[0.98]">See deployed systems</a>
      </div>
    </div>

    <div class="lg:col-span-6" data-system-map>
      <figure class="relative mx-auto max-w-xl overflow-hidden rounded-2xl border border-brand-line bg-brand-paper p-5 shadow-[0_32px_80px_-48px_rgb(0_0_0/0.35)] sm:p-7" data-hero-artifact>
        <figcaption class="flex items-center justify-between gap-4 border-b border-brand-line pb-4 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-600">
          <span>Problem-first, full-stack</span>
          <span class="flex items-center gap-2 text-brand-ember"><span class="size-1.5 rounded-full bg-brand-orange"></span> Explore each layer</span>
        </figcaption>

        <div class="mt-5 grid gap-3 sm:grid-cols-[0.9fr_1.1fr]">
          <div class="rounded-xl border border-brand-line bg-white p-4" data-problem-card>
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-brand-ember">01 / Start here</p>
            <p class="mt-2 text-lg font-semibold tracking-tight text-brand-ink">The operating problem</p>
            <p class="mt-1 text-sm leading-relaxed text-neutral-600">People, process, equipment, environment, data, and constraints.</p>
          </div>
          <div class="rounded-xl bg-brand-ink p-4 text-white" data-approach-card>
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-brand-orange">02 / ELG approach</p>
            <ol class="mt-3 grid grid-cols-3 gap-2 text-center text-[11px] font-semibold">
              <li class="rounded-lg border border-white/15 px-2 py-2">Understand</li>
              <li class="rounded-lg border border-white/15 px-2 py-2">Find bottleneck</li>
              <li class="rounded-lg border border-white/15 px-2 py-2">Design system</li>
            </ol>
          </div>
        </div>

        <div class="relative my-3 h-7" aria-hidden="true">
          <span class="absolute left-1/2 top-0 h-full w-px bg-brand-line"></span>
          <span data-flow-dot class="absolute left-[calc(50%-4px)] top-0 size-2 rounded-full bg-brand-orange shadow-[0_0_0_5px_rgb(217_95_22/0.13)]"></span>
        </div>

        <div>
          <div class="flex items-center justify-between gap-3">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-neutral-600">03 / Full-stack ecosystem</p>
            <p class="font-mono text-[9px] text-neutral-600">Select a layer</p>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3" role="group" aria-label="Explore ELG ecosystem layers">
            {STACK.map((layer, index) => (
              <button type="button" data-stack-select={layer.id} data-detail={layer.detail} aria-pressed={index === 0 ? 'true' : 'false'} class="stack-select min-h-11 rounded-lg border border-brand-line bg-white px-3 py-2 text-left font-mono text-[10px] font-semibold uppercase tracking-[0.08em] text-neutral-600 transition duration-200 hover:-translate-y-px hover:border-brand-orange hover:text-brand-ember aria-pressed:border-brand-ember aria-pressed:bg-brand-ember aria-pressed:text-white">{layer.label}</button>
            ))}
          </div>
          <div class="mt-3 rounded-xl border border-brand-line bg-white p-4" aria-live="polite">
            <p class="font-mono text-[9px] font-bold uppercase tracking-[0.14em] text-brand-ember" data-layer-label>Hardware in the ecosystem</p>
            <p class="mt-1 text-sm font-medium leading-relaxed text-brand-ink" data-layer-detail>{STACK[0].detail}</p>
          </div>
        </div>

        <div class="relative my-3 h-7" aria-hidden="true"><span class="absolute left-1/2 top-0 h-full w-px bg-brand-orange"></span></div>
        <div class="rounded-xl border border-brand-orange/30 bg-white p-4" data-system-output>
          <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-brand-ember">04 / Operational outcome</p>
          <p class="mt-1 text-lg font-semibold tracking-tight text-brand-ink">One reliable system. One accountable engineering partner.</p>
        </div>
      </figure>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const media = gsap.matchMedia();
  media.add('(prefers-reduced-motion: no-preference)', () => {
    const timeline = gsap.timeline({ defaults: { ease: 'power2.out' } });
    timeline
      .from('[data-hero-copy]', { y: 14, duration: 0.5, stagger: 0.07 })
      .from('[data-system-map]', { y: 18, duration: 0.6 }, 0.1)
      .from('[data-problem-card], [data-approach-card]', { y: 10, scale: 0.98, duration: 0.35, stagger: 0.08 }, 0.3)
      .from('[data-stack-select]', { y: 8, scale: 0.96, duration: 0.28, stagger: 0.04 }, 0.45)
      .from('[data-system-output]', { y: 8, duration: 0.35 }, 0.7);
    gsap.to('[data-flow-dot]', { y: 20, duration: 1.15, repeat: -1, ease: 'power1.inOut' });
  });

  const label = document.querySelector<HTMLElement>('[data-layer-label]');
  const detail = document.querySelector<HTMLElement>('[data-layer-detail]');
  const selectors = document.querySelectorAll<HTMLButtonElement>('[data-stack-select]');
  selectors.forEach((button) => {
    const activate = () => {
      selectors.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      if (label) label.textContent = `${button.textContent?.trim()} in the ecosystem`;
      if (detail) detail.textContent = button.dataset.detail || '';
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && detail) gsap.fromTo(detail, { y: 5 }, { y: 0, duration: 0.25, ease: 'power2.out' });
    };
    button.addEventListener('click', activate);
    button.addEventListener('mouseenter', activate);
  });
</script>
