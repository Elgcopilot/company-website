---
/** Homepage proposition and problem-to-outcome system illustration. */
---

<section class="relative overflow-hidden bg-white" aria-labelledby="home-title">
  <div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(to_right,rgb(17_17_17/0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgb(17_17_17/0.04)_1px,transparent_1px)] bg-[size:72px_72px] [mask-image:radial-gradient(ellipse_85%_75%_at_68%_40%,black,transparent_78%)]"></div>
  <div class="relative mx-auto grid min-h-[100dvh] max-w-7xl items-center gap-12 px-4 pb-16 pt-24 sm:px-6 sm:pt-28 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-6">
      <p data-hero-copy class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-neutral-600">
        Embedded systems for the real world
      </p>
      <h1 id="home-title" data-hero-copy class="mt-5 max-w-3xl text-balance text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-brand-ink sm:text-6xl lg:text-7xl">
        We turn difficult real-world problems into reliable technology.
      </h1>
      <p data-hero-copy class="mt-6 max-w-xl text-lg leading-relaxed text-neutral-600">
        ELG designs the hardware, embedded software, connectivity, and interface as one working system.
      </p>
      <div data-hero-copy class="mt-8 flex flex-wrap gap-3">
        <a href="/contact" class="group inline-flex min-h-11 items-center gap-2 rounded-full bg-brand-ink px-7 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-px hover:bg-brand-ember active:scale-[0.98]">
          Tell us the problem
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
        </a>
        <a href="/case-studies" class="inline-flex min-h-11 items-center rounded-full border border-brand-line bg-white px-7 py-3 text-sm font-semibold text-brand-ink transition duration-200 hover:-translate-y-px hover:border-brand-ink active:scale-[0.98]">
          See deployed systems
        </a>
      </div>
    </div>

    <div class="lg:col-span-6" data-system-map>
      <figure class="relative mx-auto max-w-xl overflow-hidden rounded-2xl border border-brand-line bg-brand-paper p-5 shadow-[0_32px_80px_-48px_rgb(0_0_0/0.35)] sm:p-7">
        <figcaption class="flex items-center justify-between gap-4 border-b border-brand-line pb-4 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500">
          <span>Problem to outcome</span>
          <span class="flex items-center gap-2 text-orange-800"><span class="size-1.5 rounded-full bg-brand-orange"></span> System active</span>
        </figcaption>

        <div class="relative mt-6 grid gap-3 sm:grid-cols-[1fr_54px_1fr] sm:items-center">
          <div data-system-node class="rounded-xl border border-brand-line bg-white p-4">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-orange-800">Input</p>
            <p class="mt-2 text-lg font-semibold tracking-tight text-brand-ink">A physical constraint</p>
            <p class="mt-1 text-sm leading-relaxed text-neutral-600">Heat, motion, unreliable links, complex operations.</p>
          </div>
          <div aria-hidden="true" class="relative hidden h-px bg-brand-line sm:block">
            <span data-signal class="absolute -top-1 left-0 size-2 rounded-full bg-brand-orange shadow-[0_0_0_5px_rgb(242_138_34/0.14)]"></span>
          </div>
          <div data-system-node class="relative overflow-hidden rounded-xl bg-brand-ink p-4 text-white">
            <img src="/images/brand/elg-board-3d-320.png" alt="" width="320" height="320" loading="eager" class="absolute -right-10 -top-12 h-40 w-40 object-contain opacity-35" />
            <p class="relative font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-brand-orange">ELG edge system</p>
            <p class="relative mt-2 text-lg font-semibold tracking-tight">Sense. Decide. Connect.</p>
            <p class="relative mt-1 text-sm leading-relaxed text-neutral-300">Hardware and software engineered together.</p>
          </div>
        </div>

        <div class="my-3 flex justify-center" aria-hidden="true">
          <span class="h-7 w-px bg-brand-line"></span>
        </div>

        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4" aria-label="System layers">
          <div data-system-layer class="rounded-lg border border-brand-line bg-white px-3 py-3 text-center"><span class="font-mono text-[10px] font-semibold text-neutral-600">SENSE</span></div>
          <div data-system-layer class="rounded-lg border border-brand-line bg-white px-3 py-3 text-center"><span class="font-mono text-[10px] font-semibold text-neutral-600">EDGE</span></div>
          <div data-system-layer class="rounded-lg border border-brand-line bg-white px-3 py-3 text-center"><span class="font-mono text-[10px] font-semibold text-neutral-600">CONNECT</span></div>
          <div data-system-layer class="rounded-lg border border-brand-line bg-white px-3 py-3 text-center"><span class="font-mono text-[10px] font-semibold text-neutral-600">ACT</span></div>
        </div>

        <div class="my-3 flex justify-center" aria-hidden="true">
          <span class="h-7 w-px bg-brand-orange"></span>
        </div>

        <div data-system-output class="rounded-xl border border-brand-orange/30 bg-orange-50 p-4">
          <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-orange-800">Outcome</p>
          <p class="mt-1 text-lg font-semibold tracking-tight text-brand-ink">A system people can rely on.</p>
        </div>
      </figure>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const media = gsap.matchMedia();
  media.add('(prefers-reduced-motion: no-preference)', () => {
    const timeline = gsap.timeline({ defaults: { ease: 'power2.out' } });
    timeline
      .from('[data-hero-copy]', { y: 14, duration: 0.5, stagger: 0.07 })
      .from('[data-system-map]', { y: 18, duration: 0.6 }, 0.1)
      .from('[data-system-node]', { scale: 0.97, duration: 0.3, stagger: 0.07 }, 0.28)
      .from('[data-system-layer]', { y: 8, duration: 0.28, stagger: 0.05 }, 0.44)
      .from('[data-system-output]', { y: 8, duration: 0.35 }, 0.66);

    gsap.to('[data-signal]', { x: 46, duration: 1.4, repeat: -1, ease: 'power1.inOut' });
  });
</script>
