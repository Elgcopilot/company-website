---
import Icon from './Icon.astro';
import type { IconName } from './icons';

const LAYERS: { id: string; label: string; short: string; icon: IconName }[] = [
  { id: 'hardware', label: 'Hardware', short: 'Sense', icon: 'box' },
  { id: 'firmware', label: 'Firmware', short: 'Respond', icon: 'gauge' },
  { id: 'embedded', label: 'Embedded', short: 'Decide', icon: 'chip' },
  { id: 'connectivity', label: 'Connectivity', short: 'Move', icon: 'link' },
  { id: 'cloud', label: 'Cloud', short: 'Understand', icon: 'cloud' },
  { id: 'interface', label: 'Interface', short: 'Act', icon: 'screen' },
];

const POSITIONS = [
  { top: '11%', left: '50%' },
  { top: '25%', left: '77%' },
  { top: '58%', left: '81%' },
  { top: '79%', left: '50%' },
  { top: '65%', left: '21%' },
  { top: '23%', left: '23%' },
];
---

<figure id="hero-system-artifact" class="system-artifact relative mx-auto w-full max-w-xl overflow-hidden rounded-3xl bg-white/70 shadow-[0_34px_90px_-56px_rgb(17_17_15/0.48)] ring-1 ring-brand-line/80" aria-labelledby="artifact-caption">
  <figcaption id="artifact-caption" class="flex items-center justify-between gap-4 border-b border-brand-line px-5 py-4 font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-neutral-600 sm:px-6">
    <span>Problem to system</span>
    <span class="flex items-center gap-2 text-brand-ember"><span class="size-1.5 rounded-full bg-brand-orange"></span>One build</span>
  </figcaption>

  <div class="artifact-canvas relative px-5 py-6 sm:px-7 sm:py-7">
    <div class="system-map relative h-[28rem]" role="group" aria-label="Explore ELG engineering layers">
      <svg class="connection-map pointer-events-none absolute inset-0 size-full" viewBox="0 0 620 448" preserveAspectRatio="none" aria-hidden="true">
        <path pathLength="1" class="connection-track" d="M128 224 C186 224 190 224 238 224" />
        <path pathLength="1" class="connection-live" d="M128 224 C186 224 190 224 238 224" />
        <path pathLength="1" class="connection-track" d="M382 224 C430 224 434 224 492 224" />
        <path pathLength="1" class="connection-live" d="M382 224 C430 224 434 224 492 224" />
        <path pathLength="1" class="layer-link" data-layer-link="hardware" d="M310 224 C330 170 342 94 310 57" />
        <path pathLength="1" class="layer-link" data-layer-link="firmware" d="M310 224 C390 212 438 154 468 120" />
        <path pathLength="1" class="layer-link" data-layer-link="embedded" d="M310 224 C394 236 438 272 487 254" />
        <path pathLength="1" class="layer-link" data-layer-link="connectivity" d="M310 224 C330 280 342 354 310 391" />
        <path pathLength="1" class="layer-link" data-layer-link="cloud" d="M310 224 C226 236 182 270 132 254" />
        <path pathLength="1" class="layer-link" data-layer-link="interface" d="M310 224 C230 210 182 154 152 120" />
      </svg>

      <button type="button" class="endpoint endpoint-problem" data-artifact-part="problem" data-system-node aria-describedby="artifact-summary">
        <span class="endpoint-mark" aria-hidden="true"><Icon name="layers" size={17} strokeWidth={1.6} /></span>
        <span class="endpoint-label">Problem</span>
      </button>

      <div class="system-core" data-artifact-part="engine" aria-hidden="true">
        <span class="core-orbit"></span>
        <span class="core-mark">ELG</span>
      </div>

      <button type="button" class="endpoint endpoint-system" data-artifact-part="outcome" data-system-node aria-describedby="artifact-summary">
        <span class="endpoint-mark" aria-hidden="true"><Icon name="shield" size={17} strokeWidth={1.6} /></span>
        <span class="endpoint-label">System</span>
      </button>

      {LAYERS.map((layer, index) => (
        <button
          type="button"
          class="layer-chip"
          data-layer={layer.id}
          data-label={layer.label}
          data-short={layer.short}
          aria-pressed={index === 0 ? 'true' : 'false'}
          style={`top:${POSITIONS[index].top};left:${POSITIONS[index].left};--layer:${index}`}
        >
          <span class="chip-icon" aria-hidden="true"><Icon name={layer.icon} size={15} strokeWidth={1.7} /></span>
          <span>{layer.label}</span>
        </button>
      ))}
    </div>

    <p id="artifact-summary" class="sr-only">Problem enters ELG. Hardware, firmware, embedded systems, connectivity, cloud, and interface are engineered together as one reliable system.</p>

    <div class="mt-5 flex min-h-12 items-center justify-between gap-4 border-t border-brand-line pt-4" aria-live="polite">
      <p class="min-w-0 truncate font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-neutral-600" data-stack-title>Hardware</p>
      <p class="shrink-0 font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-brand-ember" data-stack-detail>{LAYERS[0].short}</p>
    </div>
  </div>
</figure>

<style>
  .artifact-canvas {
    background-image:
      linear-gradient(rgb(17 17 15 / 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgb(17 17 15 / 0.032) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .connection-track,
  .connection-live,
  .layer-link {
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .connection-track {
    stroke: #d5d1c7;
    stroke-width: 1.5;
  }
  .connection-live {
    stroke: #d95f16;
    stroke-width: 1.5;
    stroke-dasharray: 0.012 1;
  }
  .layer-link {
    stroke: #bbb5a8;
    stroke-dasharray: 3 7;
    stroke-width: 1.4;
    transition: stroke 180ms ease, stroke-width 180ms ease;
  }
  .layer-link.is-active {
    stroke: #d95f16;
    stroke-width: 2;
  }
  .system-map {
    transform-origin: center;
  }
  .endpoint {
    position: absolute;
    top: 50%;
    z-index: 20;
    display: flex;
    min-height: 3.5rem;
    width: 8.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-radius: 999px;
    border: 1px solid #d5d1c7;
    background: rgb(255 255 255 / 0.94);
    color: #11110f;
    font-weight: 700;
    letter-spacing: -0.015em;
    box-shadow: 0 16px 34px -26px rgb(17 17 15 / 0.55);
    transform: translateY(-50%);
    transition: border-color 180ms ease, box-shadow 180ms ease, color 180ms ease;
  }
  .endpoint-problem { left: 0; }
  .endpoint-system { right: 0; }
  .endpoint:hover,
  .endpoint:focus-visible {
    border-color: #d95f16;
    color: #9f3f0c;
    box-shadow: 0 18px 38px -25px rgb(217 95 22 / 0.42);
  }
  .endpoint-mark {
    display: grid;
    size: 2rem;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 999px;
    background: #f1eee7;
    color: #d95f16;
  }
  .system-core {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 15;
    display: grid;
    width: 9rem;
    height: 9rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    background: #151511;
    color: white;
    box-shadow: 0 30px 60px -36px rgb(17 17 15 / 0.76);
    transform: translate(-50%, -50%);
  }
  .core-mark {
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }
  .core-orbit {
    position: absolute;
    inset: 1.1rem;
    border: 1px dashed rgb(217 95 22 / 0.42);
    border-radius: inherit;
  }
  .layer-chip {
    position: absolute;
    z-index: 25;
    display: flex;
    min-height: 2.55rem;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid #d5d1c7;
    border-radius: 999px;
    padding: 0.42rem 0.78rem 0.42rem 0.42rem;
    background: rgb(255 255 255 / 0.95);
    color: #2c2b27;
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    box-shadow: 0 14px 28px -24px rgb(17 17 15 / 0.45);
    transform: translate(-50%, -50%);
    transition: border-color 170ms ease, background-color 170ms ease, box-shadow 170ms ease, color 170ms ease;
    white-space: nowrap;
  }
  .chip-icon {
    display: grid;
    width: 1.65rem;
    height: 1.65rem;
    place-items: center;
    border-radius: 999px;
    background: #f1eee7;
    color: #d95f16;
    transition: background-color 170ms ease, color 170ms ease, transform 170ms ease;
  }
  .layer-chip:hover,
  .layer-chip:focus-visible,
  .layer-chip[aria-pressed='true'] {
    border-color: #d95f16;
    background: #fff8f1;
    color: #9f3f0c;
    box-shadow: 0 16px 32px -24px rgb(217 95 22 / 0.38);
  }
  .layer-chip:hover .chip-icon,
  .layer-chip:focus-visible .chip-icon,
  .layer-chip[aria-pressed='true'] .chip-icon {
    background: #d95f16;
    color: white;
  }
  .endpoint:focus-visible,
  .layer-chip:focus-visible {
    outline: 2px solid #d95f16;
    outline-offset: 3px;
  }
  @media (max-width: 640px) {
    .system-map {
      height: 28.5rem;
    }
    .endpoint {
      width: 6.8rem;
      min-height: 3rem;
      gap: 0.4rem;
      font-size: 0.82rem;
    }
    .endpoint-mark {
      width: 1.62rem;
      height: 1.62rem;
    }
    .system-core {
      width: 7.15rem;
      height: 7.15rem;
    }
    .layer-chip {
      min-height: 2.2rem;
      gap: 0.28rem;
      padding: 0.3rem 0.46rem 0.3rem 0.3rem;
      font-size: 0.49rem;
      letter-spacing: 0.025em;
    }
    .chip-icon {
      width: 1.26rem;
      height: 1.26rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .connection-live { animation: signal-travel 2.8s linear infinite; }
    .core-orbit { animation: orbit-drift 12s linear infinite; }
    .layer-chip:hover .chip-icon,
    .layer-chip:focus-visible .chip-icon,
    .layer-chip[aria-pressed='true'] .chip-icon {
      animation: chip-settle 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
  }
  @keyframes signal-travel {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: -1; }
  }
  @keyframes orbit-drift {
    to { transform: rotate(360deg); }
  }
  @keyframes chip-settle {
    0% { transform: scale(1); }
    42% { transform: scale(1.12); }
    100% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .connection-live,
    .core-orbit,
    .chip-icon {
      animation: none !important;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const artifact = document.getElementById('hero-system-artifact');
  if (artifact) {
    const buttons = artifact.querySelectorAll<HTMLButtonElement>('[data-layer]');
    const links = artifact.querySelectorAll<SVGPathElement>('[data-layer-link]');
    const title = artifact.querySelector<HTMLElement>('[data-stack-title]');
    const detail = artifact.querySelector<HTMLElement>('[data-stack-detail]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const activate = (button: HTMLButtonElement) => {
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      links.forEach((link) => link.classList.toggle('is-active', link.dataset.layerLink === button.dataset.layer));
      if (title) title.textContent = button.dataset.label || '';
      if (detail) detail.textContent = button.dataset.short || '';
      if (!reduce && detail) gsap.fromTo(detail, { y: 4, autoAlpha: 0.55 }, { y: 0, autoAlpha: 1, duration: 0.22, ease: 'power2.out' });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => activate(button));
      button.addEventListener('pointerenter', () => activate(button));
      button.addEventListener('focus', () => activate(button));
    });

    if (!reduce) {
      const timeline = gsap.timeline({ defaults: { ease: 'power2.out' } });
      timeline
        .from(artifact.querySelector('[data-artifact-part="problem"]'), { x: -14, autoAlpha: 0, duration: 0.4 })
        .from(artifact.querySelector('[data-artifact-part="engine"]'), { scale: 0.86, autoAlpha: 0, duration: 0.48 }, 0.1)
        .from(artifact.querySelector('[data-artifact-part="outcome"]'), { x: 14, autoAlpha: 0, duration: 0.4 }, 0.16)
        .from(buttons, { autoAlpha: 0, y: 8, duration: 0.28, stagger: 0.045 }, 0.28);
    }
  }
</script>
