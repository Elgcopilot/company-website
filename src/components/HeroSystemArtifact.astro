---
import Icon from './Icon.astro';
import type { IconName } from './icons';

/**
 * Hero artifact — the signal path.
 *
 * One idea, readable in a glance: a problem enters at the top, travels
 * down through the six layers ELG engineers, and leaves as a working
 * system. Each layer carries one verb, so nothing needs to be clicked
 * or read in full to understand the point.
 */
const LAYERS: { label: string; role: string; icon: IconName }[] = [
  { label: 'Hardware', role: 'Sense', icon: 'box' },
  { label: 'Firmware', role: 'Respond', icon: 'gauge' },
  { label: 'Embedded', role: 'Decide', icon: 'chip' },
  { label: 'Connectivity', role: 'Move', icon: 'link' },
  { label: 'Cloud', role: 'Understand', icon: 'cloud' },
  { label: 'Interface', role: 'Act', icon: 'screen' },
];
---

<figure id="hero-system-artifact" class="system-artifact relative mx-auto w-full max-w-md overflow-hidden rounded-3xl bg-white shadow-[0_34px_90px_-56px_rgb(17_17_15/0.5)] ring-1 ring-brand-line/80" aria-labelledby="artifact-caption">
  <figcaption id="artifact-caption" class="flex items-center justify-between gap-4 border-b border-brand-line px-5 py-4 font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-neutral-600 sm:px-6">
    <span>Problem to working system</span>
    <span class="flex items-center gap-2 text-brand-ember"><span class="size-1.5 rounded-full bg-brand-orange"></span>Every layer</span>
  </figcaption>

  <div class="signal-board relative px-5 py-6 sm:px-6">
    <span class="spine" aria-hidden="true"></span>
    <span class="pulse" aria-hidden="true"></span>

    <p class="cap">
      <span class="cap-dot cap-dot-start" aria-hidden="true"></span>
      <span class="cap-text">A real problem</span>
    </p>

    <div class="scope">
      <span class="scope-tag" aria-hidden="true">ELG</span>
      <ol class="layer-list">
        {LAYERS.map((layer, index) => (
          <li class="layer-row" style={`--i:${index}`}>
            <span class="row-icon" aria-hidden="true"><Icon name={layer.icon} size={15} strokeWidth={1.7} /></span>
            <span class="row-label">{layer.label}</span>
            <span class="row-role">{layer.role}</span>
          </li>
        ))}
      </ol>
    </div>

    <p class="cap">
      <span class="cap-dot cap-dot-end" aria-hidden="true"></span>
      <span class="cap-text cap-text-end">A working system</span>
    </p>
  </div>
</figure>

<style>
  .signal-board {
    --marker: 2rem;
    --gutter: 1.25rem;
    --spine-x: calc(var(--gutter) + var(--marker) / 2);
    background-image:
      linear-gradient(rgb(17 17 15 / 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgb(17 17 15 / 0.028) 1px, transparent 1px);
    background-size: 30px 30px;
  }
  .spine,
  .pulse {
    position: absolute;
    left: calc(1.25rem + var(--spine-x));
    transform: translateX(-50%);
  }
  .spine {
    top: 2.6rem;
    bottom: 2.6rem;
    width: 2px;
    border-radius: 999px;
    background: linear-gradient(#e2ded4, #d5d1c7);
  }
  .pulse {
    top: 2.6rem;
    z-index: 0;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: #d95f16;
    box-shadow: 0 0 0 4px rgb(217 95 22 / 0.14);
    opacity: 0;
  }
  .cap {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: var(--marker) 1fr;
    align-items: center;
    gap: 0.75rem;
    padding-left: var(--gutter);
  }
  .cap-dot {
    justify-self: center;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
  }
  .cap-dot-start {
    border: 2px solid #b4aea1;
    background: white;
  }
  .cap-dot-end {
    border: 2px solid #d95f16;
    background: #d95f16;
    box-shadow: 0 0 0 5px rgb(217 95 22 / 0.12);
  }
  .cap-text {
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #11110f;
  }
  .cap-text-end { color: #9f3f0c; }
  .scope {
    position: relative;
    z-index: 1;
    margin: 0.85rem 0;
    padding: 0.55rem 0;
  }
  .scope::before {
    content: '';
    position: absolute;
    inset: 0;
    left: 0.45rem;
    border: 1px solid #e4e0d6;
    border-radius: 0.9rem;
    background: rgb(249 247 243 / 0.75);
  }
  .scope-tag {
    position: absolute;
    top: 50%;
    left: 0.45rem;
    z-index: 2;
    padding: 0.4rem 0.1rem;
    border-radius: 0.3rem;
    background: #d95f16;
    color: white;
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.5rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    writing-mode: vertical-rl;
    transform: translate(-50%, -50%);
  }
  .layer-list {
    position: relative;
    z-index: 1;
    display: grid;
  }
  .layer-row {
    display: grid;
    grid-template-columns: var(--marker) 1fr auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.9rem;
    padding-left: var(--gutter);
    padding-right: 0.9rem;
    border-radius: 0.65rem;
    transition: background-color 180ms ease;
  }
  .layer-row:hover { background: rgb(217 95 22 / 0.05); }
  .row-icon {
    display: grid;
    justify-self: center;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border: 1px solid #e0dcd2;
    border-radius: 999px;
    background: white;
    color: #d95f16;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease;
  }
  .layer-row:hover .row-icon {
    border-color: #d95f16;
    background: #d95f16;
    color: white;
  }
  .row-label {
    font-size: 0.94rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    color: #2c2b27;
  }
  .row-role {
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8c8578;
    transition: color 180ms ease;
  }
  .layer-row:hover .row-role { color: #9f3f0c; }
  @media (max-width: 480px) {
    .signal-board { --marker: 1.75rem; --gutter: 0.75rem; }
    .cap-text { font-size: 0.94rem; }
    .row-label { font-size: 0.88rem; }
    .row-role { font-size: 0.55rem; letter-spacing: 0.1em; }
    .layer-row { min-height: 2.7rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .pulse { animation: pulse-travel 4.2s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .row-icon { animation: row-charge 4.2s linear infinite; animation-delay: calc(var(--i) * 0.6s + 0.6s); }
  }
  @keyframes pulse-travel {
    0% { top: 2.6rem; opacity: 0; }
    8% { opacity: 1; }
    92% { opacity: 1; }
    100% { top: calc(100% - 2.6rem); opacity: 0; }
  }
  @keyframes row-charge {
    0% { border-color: #e0dcd2; background: white; color: #d95f16; }
    4% { border-color: #d95f16; background: #d95f16; color: white; }
    16% { border-color: #e0dcd2; background: white; color: #d95f16; }
    100% { border-color: #e0dcd2; background: white; color: #d95f16; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse { display: none; }
    .row-icon { animation: none !important; }
  }
</style>
