---
/**
 * ProofBand — dark evidence band with oversized mono metrics.
 * PROTOTYPE icons: each metric gets a pictogram (gauge / chip / shield /
 * box) at the same ink-tile treatment, so the numbers read visually first.
 * Values unchanged — real field outcomes from case studies.
 */
import Icon from './Icon.astro';

const METRICS = [
  { icon: 'gauge' as const, value: 'Sub-100ms', label: 'Trackside telemetry streaming', note: 'ISUZU motorsport, under race conditions' },
  { icon: 'chip' as const, value: '25Hz', label: 'CAN / GPS acquisition cadence', note: 'Sustained during professional sessions' },
  { icon: 'shield' as const, value: '100%', label: 'Zero-failure race-event operation', note: 'No dropped sessions on competition day' },
  { icon: 'box' as const, value: '10', label: 'Field-deployed ecosystems', note: 'Motorsport, energy, enterprise, agriculture' },
];
---

<section class="bg-brand-coal text-white" aria-label="Field-proven outcomes">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-neutral-400">
        <span class="mr-2 inline-block size-1.5 rounded-full bg-brand-orange align-middle"></span>
        Proof, not promises
      </p>
      <a href="/case-studies" class="text-sm font-semibold text-neutral-300 transition-colors hover:text-brand-orange">
        Browse all 10 case studies →
      </a>
    </div>
    <dl class="mt-10 grid gap-px overflow-hidden rounded-2xl bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
      {METRICS.map((m) => (
        <div class="group bg-brand-coal p-7 transition-colors duration-200 hover:bg-white/[0.05] sm:p-8" data-reveal>
          <span class="grid size-11 place-items-center rounded-lg bg-white/10 text-brand-orange transition-colors duration-200 group-hover:bg-brand-ember group-hover:text-white" aria-hidden="true">
            <Icon name={m.icon} size={22} />
          </span>
          <dd class="mt-5 whitespace-nowrap font-mono text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-[2.55rem]">{m.value}</dd>
          <dt class="mt-3 text-sm font-semibold text-neutral-200">{m.label}</dt>
          <p class="mt-1 text-xs leading-relaxed text-neutral-500">{m.note}</p>
        </div>
      ))}
    </dl>
    <p class="mt-6 font-mono text-[11px] leading-relaxed text-neutral-500" data-reveal>
      * Figures reflect deployed field configurations; detailed test conditions available under NDA.
    </p>
  </div>
</section>
