---
interface Props { compact?: boolean; light?: boolean; }
const { compact = false, light = false } = Astro.props;
---

{compact ? (
  <img src="/images/brand/elg-mark-gold-cropped.png" alt="Embedded Linux Group" width="180" height="140" class="h-9 w-12 object-contain" />
) : (
  <img src="/images/brand/elg-logo-reference.png" alt="Embedded Linux Group" width="460" height="140" class:list={['h-9 w-auto sm:h-10', light && 'brightness-0 invert']} />
)}
