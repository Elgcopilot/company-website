---
/**
 * FinalCta — closing conversion section. Massive type, one decisive action.
 * Primary action is ink-black (production-grade); orange reserved for micro-accents.
 */
import { COMPANY } from '@/data/company';
---

<section class="bg-white" aria-label="Contact">
  <div class="mx-auto max-w-7xl px-4 py-24 text-center sm:px-6 sm:py-32">
    <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-neutral-500" data-reveal>05 — Start</p>
    <h2
      class="mx-auto mt-5 max-w-4xl text-4xl font-semibold leading-[1.02] tracking-[-0.035em] text-brand-ink sm:text-6xl md:text-7xl"
      data-reveal
    >
      Bring us the requirement. We will engineer the ecosystem.
    </h2>
    <p class="mx-auto mt-6 max-w-xl leading-relaxed text-neutral-600" data-reveal>
      Tell us the operating reality — via the qualification form, LINE, or a call.
      We reply within one business day.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-3" data-reveal>
      <a
        href="/contact"
        class="group inline-flex items-center gap-2 rounded-full bg-brand-ink px-8 py-4 text-sm font-semibold text-white transition-all duration-200 hover:-translate-y-px hover:bg-black active:scale-[0.98]"
      >
        Schedule an Engineering Consultation
        <span aria-hidden="true" class="grid size-5 place-items-center rounded-full bg-brand-orange text-xs leading-none transition-transform duration-200 group-hover:translate-x-0.5">→</span>
      </a>
      <a
        href={COMPANY.lineUrl}
        class="rounded-full border border-brand-line bg-white px-8 py-4 text-sm font-semibold text-brand-ink transition-all duration-200 hover:-translate-y-px hover:border-brand-ink active:scale-[0.98]"
      >
        LINE: {COMPANY.lineId}
      </a>
    </div>
    <p class="mt-8 font-mono text-xs text-neutral-500" data-reveal>
      {COMPANY.email} <span aria-hidden="true" class="mx-2 text-neutral-300">/</span> {COMPANY.phone}
    </p>
  </div>
</section>
