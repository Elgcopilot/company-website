---
import { COMPANY } from '@/data/company';
---

<section class="border-t border-brand-line bg-brand-paper" aria-labelledby="contact-title">
  <div class="mx-auto max-w-7xl px-4 py-24 text-center sm:px-6 sm:py-32">
    <h2 id="contact-title" class="mx-auto max-w-4xl text-balance text-5xl font-semibold leading-[1] tracking-[-0.04em] text-brand-ink sm:text-7xl">Have a difficult problem?</h2>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-neutral-600">Tell us what is happening in the real world. We will start there.</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href="/contact" class="group inline-flex min-h-11 items-center gap-2 rounded-full bg-brand-ink px-8 py-4 text-sm font-semibold text-white transition duration-200 hover:-translate-y-px hover:bg-brand-ember active:scale-[0.98]">Tell us the problem <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span></a>
      <a href={COMPANY.lineUrl} class="inline-flex min-h-11 items-center rounded-full border border-brand-line bg-white px-8 py-4 text-sm font-semibold text-brand-ink transition duration-200 hover:-translate-y-px hover:border-brand-ink active:scale-[0.98]">LINE {COMPANY.lineId}</a>
    </div>
    <p class="mt-7 font-mono text-xs text-neutral-600">{COMPANY.email} · {COMPANY.phone}</p>
  </div>
</section>
