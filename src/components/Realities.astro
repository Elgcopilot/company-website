---
/**
 * Realities — the gap between idea and field-ready product (zero JS).
 * Reframed for the non-technical visitor: you have the idea and domain
 * expertise — ELG implements it into the real world. Harsh-environment
 * proof points support, not lead.
 */
const CONSTRAINTS = [
  { title: 'You have the idea — not the implementation path', body: 'Entrepreneurs, domain experts, and business owners see the opportunity clearly. Turning it into hardware, firmware, and dashboards that survive the real world is where ELG comes in — one accountable partner, start to finish.' },
  { title: 'High vibration & shock', body: 'Mounts crack, connectors walk out, sample cadence collapses. We specify retention, damping, and acquisition loops that hold under mechanical stress.' },
  { title: 'Extreme heat & dust', body: 'Thermal throttling kills compute when it matters most. Our enclosures and power budgets are designed for trackside and rooftop reality.' },
  { title: 'Noisy electrical environments', body: 'Motors, inverters, and dense RF crowds corrupt signals. Shielding, filtering, and protocol choices are made for the noise floor you actually have.' },
  { title: 'Intermittent connectivity', body: 'Remote sites drop links for hours. Local buffering, store-and-forward, and edge logic keep the system useful with or without the cloud.' },
];
---

<section class="bg-white" aria-label="Operating realities">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-neutral-500">01 — The problem we solve</p>
        <h2 class="mt-4 text-3xl font-semibold leading-[1.05] tracking-[-0.03em] text-brand-ink sm:text-5xl">
          Great ideas die without implementation.
        </h2>
      </div>
      <div class="lg:col-span-7" data-reveal data-reveal-delay="0.1">
        <p class="max-w-xl text-base leading-relaxed text-neutral-600 sm:text-lg">
          You bring the idea and the domain expertise — ELG implements it into a product
          that works in the real world. One-stop, fully customized, from MOQ 5 units.
        </p>
        <ol class="mt-10 divide-y divide-brand-line border-y border-brand-line">
          {CONSTRAINTS.map((c, i) => (
            <li class="group grid gap-2 py-6 transition-colors duration-200 hover:bg-brand-paper sm:grid-cols-12 sm:gap-4 sm:px-4">
              <span class="font-mono text-xs font-semibold text-brand-ember sm:col-span-1 sm:pt-1">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="sm:col-span-11">
                <h3 class="text-lg font-semibold tracking-tight text-brand-ink">{c.title}</h3>
                <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-neutral-600">{c.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
