---
import Icon from './Icon.astro';
import type { IconName } from './icons';

const PIECES: { title: string; value: string; technical: string; icon: IconName; final?: boolean }[] = [
  { title: 'A dependable foundation', value: 'Keeps your product stable, secure, and ready for long-term use.', technical: 'Embedded Linux', icon: 'layers' },
  { title: 'Fast, precise responses', value: 'Controls equipment and responds when timing cannot slip.', technical: 'RTOS & Firmware', icon: 'gauge' },
  { title: 'Intelligence where it happens', value: 'Makes useful decisions locally, even without a constant connection.', technical: 'Edge AI', icon: 'cog' },
  { title: 'A connection that holds', value: 'Moves information reliably across devices, sites, and networks.', technical: 'IoT & Connectivity', icon: 'link' },
  { title: 'Clear control for people', value: 'Turns complex operations into interfaces teams can understand and use.', technical: 'UX, UI & HMI', icon: 'screen' },
  { title: 'One shared operational view', value: 'Completes the system with live data, history, alerts, and remote access.', technical: 'Cloud Platform', icon: 'cloud', final: true },
];

type PuzzleTab = -1 | 0 | 1;
interface PuzzleEdge {
  tab: PuzzleTab;
  center?: number;
}
interface PuzzleShape {
  top: PuzzleEdge;
  right: PuzzleEdge;
  bottom: PuzzleEdge;
  left: PuzzleEdge;
}

const PUZZLE_SIZE = 100;
const PUZZLE_CORNER = 12;
const PUZZLE_NECK = 7;
const PUZZLE_BULB = 8;
const PUZZLE_DEPTH = 11;

const formatPoint = (value: number) => Number(value.toFixed(2));

function jigsawEdge(x1: number, y1: number, x2: number, y2: number, edge: PuzzleEdge): string {
  if (edge.tab === 0) return `L ${x2} ${y2}`;

  const center = edge.center ?? 50;
  const dx = x2 - x1;
  const dy = y2 - y1;
  const length = Math.hypot(dx, dy);
  const ux = dx / length;
  const uy = dy / length;
  const nx = -uy;
  const ny = ux;
  const cx = x1 + (dx * center) / 100;
  const cy = y1 + (dy * center) / 100;
  const side = edge.tab;
  const sweep = side < 0 ? 1 : 0;
  const neckStartX = formatPoint(cx - ux * PUZZLE_NECK);
  const neckStartY = formatPoint(cy - uy * PUZZLE_NECK);
  const lobeStartX = formatPoint(cx - ux * PUZZLE_BULB + nx * side * PUZZLE_DEPTH);
  const lobeStartY = formatPoint(cy - uy * PUZZLE_BULB + ny * side * PUZZLE_DEPTH);
  const lobeEndX = formatPoint(cx + ux * PUZZLE_BULB + nx * side * PUZZLE_DEPTH);
  const lobeEndY = formatPoint(cy + uy * PUZZLE_BULB + ny * side * PUZZLE_DEPTH);
  const neckEndX = formatPoint(cx + ux * PUZZLE_NECK);
  const neckEndY = formatPoint(cy + uy * PUZZLE_NECK);

  return [
    `L ${neckStartX} ${neckStartY}`,
    `C ${formatPoint(neckStartX + ux * 2.2 + nx * side * 2)} ${formatPoint(neckStartY + uy * 2.2 + ny * side * 2)}`,
    `${formatPoint(lobeStartX - ux * 2.8 + nx * side * 2.8)} ${formatPoint(lobeStartY - uy * 2.8 + ny * side * 2.8)}`,
    `${lobeStartX} ${lobeStartY}`,
    `A ${PUZZLE_BULB} ${PUZZLE_BULB} 0 0 ${sweep} ${lobeEndX} ${lobeEndY}`,
    `C ${formatPoint(lobeEndX + ux * 2.8 + nx * side * 2.8)} ${formatPoint(lobeEndY + uy * 2.8 + ny * side * 2.8)}`,
    `${formatPoint(neckEndX - ux * 2.2 + nx * side * 2)} ${formatPoint(neckEndY - uy * 2.2 + ny * side * 2)}`,
    `${neckEndX} ${neckEndY}`,
    `L ${x2} ${y2}`,
  ].join(' ');
}

function puzzlePath(shape: PuzzleShape): string {
  const edge = PUZZLE_SIZE - PUZZLE_CORNER;
  return [
    `M ${PUZZLE_CORNER} 0`,
    jigsawEdge(PUZZLE_CORNER, 0, edge, 0, shape.top),
    `Q ${PUZZLE_SIZE} 0 ${PUZZLE_SIZE} ${PUZZLE_CORNER}`,
    jigsawEdge(PUZZLE_SIZE, PUZZLE_CORNER, PUZZLE_SIZE, edge, shape.right),
    `Q ${PUZZLE_SIZE} ${PUZZLE_SIZE} ${edge} ${PUZZLE_SIZE}`,
    jigsawEdge(edge, PUZZLE_SIZE, PUZZLE_CORNER, PUZZLE_SIZE, shape.bottom),
    `Q 0 ${PUZZLE_SIZE} 0 ${edge}`,
    jigsawEdge(0, edge, 0, PUZZLE_CORNER, shape.left),
    `Q 0 0 ${PUZZLE_CORNER} 0`,
    'Z',
  ].join(' ');
}

const straight: PuzzleEdge = { tab: 0 };
// Desktop 3×2 edges use shared connector centers so tabs and dents align.
const DESKTOP_SHAPES: PuzzleShape[] = [
  { top: straight, right: { tab: -1, center: 38 }, bottom: { tab: -1, center: 62 }, left: straight },
  { top: straight, right: { tab: -1, center: 62 }, bottom: { tab: 1, center: 38 }, left: { tab: 1, center: 62 } },
  { top: straight, right: straight, bottom: { tab: -1, center: 62 }, left: { tab: 1, center: 38 } },
  { top: { tab: 1, center: 38 }, right: { tab: -1, center: 62 }, bottom: straight, left: straight },
  { top: { tab: -1, center: 62 }, right: { tab: 1, center: 38 }, bottom: straight, left: { tab: 1, center: 38 } },
  { top: { tab: 1, center: 38 }, right: straight, bottom: straight, left: { tab: -1, center: 62 } },
];
// Mobile single-column edges form one vertical interlocking chain.
const MOBILE_JOINTS = [38, 62, 45, 58, 42];
const MOBILE_SHAPES: PuzzleShape[] = PIECES.map((_, index) => ({
  top: index === 0 ? straight : { tab: 1, center: 100 - MOBILE_JOINTS[index - 1] },
  right: straight,
  bottom: index === PIECES.length - 1 ? straight : { tab: -1, center: MOBILE_JOINTS[index] },
  left: straight,
}));
---

<section id="capability-system" class="overflow-visible bg-brand-paper" aria-labelledby="capabilities-title">
  <div class="capability-scroll-stage">
  <div class="capability-sticky mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="max-w-3xl">
      <h2 id="capabilities-title" class="text-balance text-4xl font-semibold leading-[1.03] tracking-[-0.035em] text-brand-ink sm:text-6xl">Six pieces. One working system.</h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-600">Each piece solves a different part of the operation. The value appears when they connect.</p>
    </div>

    <div class="mt-12 lg:px-10">
      <div class="mb-4 flex items-center justify-between gap-4 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-neutral-600">
        <span data-assembly-state>Scroll to assemble</span>
        <span class="hidden items-center gap-2 md:flex"><span class="size-1.5 rounded-full bg-brand-orange"></span> Problem to complete ecosystem</span>
      </div>
      <div class="assembly-progress mb-5" aria-hidden="true"><span data-assembly-progress></span></div>
      <div class="puzzle-assembly relative rounded-2xl" data-puzzle-assembly>
      <ol class="puzzle-grid relative z-10 grid gap-0" aria-label="Six connected ELG capability building blocks">
        {PIECES.map((piece, index) => (
          <li
            data-puzzle-piece
            data-final-piece={piece.final ? '' : undefined}
            class="puzzle-piece relative isolate min-h-64 p-6 sm:p-7"
          >
            <svg class="pointer-events-none absolute inset-0 h-full w-full overflow-visible md:hidden" viewBox="-14 -14 128 128" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path
                d={puzzlePath(MOBILE_SHAPES[index])}
                class={piece.final ? 'fill-brand-ember stroke-[#7A2F08]' : 'fill-white stroke-brand-line'}
                stroke-width="1.5"
                stroke-linejoin="round"
                vector-effect="non-scaling-stroke"
              />
            </svg>
            <svg class="pointer-events-none absolute inset-0 hidden h-full w-full overflow-visible md:block" viewBox="-14 -14 128 128" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path
                d={puzzlePath(DESKTOP_SHAPES[index])}
                class={piece.final ? 'fill-brand-ember stroke-[#7A2F08]' : 'fill-white stroke-brand-line'}
                stroke-width="1.5"
                stroke-linejoin="round"
                vector-effect="non-scaling-stroke"
              />
            </svg>
            <div class:list={['relative z-10 flex h-full flex-col', piece.final ? 'text-white' : 'text-brand-ink']}>
              <div data-puzzle-icon class:list={['grid size-12 place-items-center rounded-xl transition-transform duration-300', piece.final ? 'bg-brand-ink text-white' : 'bg-brand-mist text-neutral-700']} aria-hidden="true">
                <Icon name={piece.icon} size={23} />
              </div>
              <p class:list={['mt-7 font-mono text-[10px] font-bold uppercase tracking-[0.16em]', piece.final ? 'text-white' : 'text-neutral-500']}>0{index + 1} / {piece.technical}</p>
              <h3 class="mt-2 text-xl font-semibold leading-tight tracking-[-0.02em] sm:text-2xl">{piece.title}</h3>
              <p class:list={['mt-3 text-sm leading-relaxed', piece.final ? 'text-white/90' : 'text-neutral-600']}>{piece.value}</p>
              {piece.final && <p class="mt-auto pt-6 font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-white">Final piece: system complete</p>}
            </div>
          </li>
        ))}
      </ol>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-5 border-t border-brand-line pt-7 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-2xl text-lg font-semibold tracking-tight text-brand-ink">ELG connects the pieces so your team manages one outcome, not six suppliers.</p>
      <a href="/solutions" class="inline-flex min-h-11 shrink-0 items-center gap-2 text-sm font-semibold text-brand-ember underline-offset-4 hover:underline">Explore all solutions <span aria-hidden="true">→</span></a>
    </div>
  </div>
  </div>
</section>

<style>
  .puzzle-piece {
    overflow: visible;
    margin: -0.5px;
    border: 0;
    border-radius: 0;
    background: transparent;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 300ms ease, filter 300ms ease;
  }
  .puzzle-piece:hover {
    z-index: 30;
    transform: translateY(-5px) scale(1.012);
    box-shadow: 0 22px 48px -30px rgb(17 17 15 / 0.45);
  }
  .puzzle-piece:hover [data-puzzle-icon] {
    transform: rotate(5deg) scale(1.08);
  }
  .puzzle-assembly::before {
    --rim-angle: 0deg;
    content: '';
    position: absolute;
    z-index: 0;
    inset: -5px;
    border-radius: 18px;
    padding: 3px;
    background: conic-gradient(from var(--rim-angle), transparent 0 76%, #d95f16 84%, #ffd7bd 90%, #d95f16 96%, transparent 100%);
    opacity: 0;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }
  .puzzle-assembly.is-complete::before {
    opacity: 1;
    animation: rim-circuit 2.4s linear infinite;
    filter: drop-shadow(0 0 6px rgb(217 95 22 / 0.7));
  }
  @property --rim-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes rim-circuit { to { --rim-angle: 360deg; } }
  .assembly-progress {
    height: 3px;
    border-radius: 999px;
    background: #d5d1c7;
    overflow: hidden;
  }
  .assembly-progress > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #d95f16, #f2a35e);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (min-width: 768px) {
    .puzzle-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .capability-sticky {
      display: flex;
      min-height: calc(100vh - 64px);
      flex-direction: column;
      justify-content: center;
      padding-top: 2rem;
      padding-bottom: 2rem;
    }
    .puzzle-piece {
      min-height: clamp(11.5rem, 23vh, 14.5rem);
      padding: 1.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .puzzle-assembly::before { display: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.getElementById('capability-system');
  if (section) {
    const media = gsap.matchMedia();
    const buildAssembly = (isPinnedStage: boolean) => {
      const pieces = section.querySelectorAll('[data-puzzle-piece]');
      const icons = section.querySelectorAll('[data-puzzle-icon]');
      const assembly = section.querySelector('[data-puzzle-assembly]');
      const state = section.querySelector('[data-assembly-state]');
      const progress = section.querySelector('[data-assembly-progress]');
      const sticky = section.querySelector('.capability-sticky');
      let complete = false;
      const setComplete = (next: boolean) => {
        if (complete === next) return;
        complete = next;
        if (next && assembly) {
          assembly.classList.remove('is-complete');
          void (assembly as HTMLElement).offsetWidth;
          assembly.classList.add('is-complete');
        } else {
          assembly?.classList.remove('is-complete');
        }
        if (state) state.textContent = next ? 'Connected: ecosystem complete' : 'Scroll to assemble';
      };
      const desktopOffsets = [
        { x: -240, y: -125, rotation: -8 },
        { x: 0, y: -175, rotation: 5 },
        { x: 240, y: -125, rotation: 8 },
        { x: -240, y: 125, rotation: 7 },
        { x: 0, y: 175, rotation: -5 },
        { x: 280, y: 145, rotation: 10 },
      ];
      const compactOffsets = desktopOffsets.map(({ x, y, rotation }) => ({ x: x * 0.42, y: y * 0.42, rotation: rotation * 0.6 }));
      const offsets = isPinnedStage ? desktopOffsets : compactOffsets;
      const timeline = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: section,
          start: isPinnedStage ? 'top top+=64' : 'top 88%',
          end: isPinnedStage ? '+=1500' : 'center 42%',
          pin: isPinnedStage ? sticky : false,
          pinSpacing: isPinnedStage,
          anticipatePin: isPinnedStage ? 1 : 0,
          scrub: isPinnedStage ? 1.4 : 0.9,
          invalidateOnRefresh: true,
          onUpdate: (self) => setComplete(self.progress >= 0.875),
          onLeave: () => setComplete(true),
          onEnterBack: () => setComplete(true),
          onLeaveBack: () => setComplete(false),
        },
      });
      timeline
        .fromTo(
          pieces,
          {
            x: (index) => offsets[index]?.x ?? 0,
            y: (index) => offsets[index]?.y ?? 0,
            rotation: (index) => offsets[index]?.rotation ?? 0,
            scale: (index) => index === 5 ? 0.72 : 0.8,
          },
          { x: 0, y: 0, rotation: 0, scale: 1, duration: 0.84 },
        )
        .fromTo(icons, { rotation: -12, scale: 0.76 }, { rotation: 0, scale: 1, duration: 0.36 }, 0.38);
      if (progress) timeline.fromTo(progress, { scaleX: 0 }, { scaleX: 1, duration: 0.84, ease: 'none' }, 0);
      timeline.to({}, { duration: 0.12 });
    };
    media.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      buildAssembly(true);
    });
    media.add('(max-width: 1023px) and (prefers-reduced-motion: no-preference)', () => {
      buildAssembly(false);
    });
  }
</script>
