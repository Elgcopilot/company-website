---
import Icon from './Icon.astro';
import type { IconName } from './icons';

const OUTCOMES: { title: string; scope: string; icon: IconName }[] = [
  { title: 'Sense the physical world', scope: 'Electronics, sensors, and data acquisition', icon: 'vibration' },
  { title: 'Decide at the edge', scope: 'Embedded Linux, RTOS, and edge AI', icon: 'chip' },
  { title: 'Stay connected', scope: 'Cellular, Wi-Fi, Zigbee, MQTT, and gateways', icon: 'link' },
  { title: 'Turn data into action', scope: 'Cloud services, dashboards, and operational interfaces', icon: 'screen' },
];
---

<section class="bg-brand-paper" aria-labelledby="capabilities-title">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="max-w-3xl">
      <h2 id="capabilities-title" class="text-balance text-4xl font-semibold leading-[1.03] tracking-[-0.035em] text-brand-ink sm:text-6xl">
        From physical signals to useful action.
      </h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-600">
        Four outcomes, engineered as one system around the problem you need to solve.
      </p>
    </div>

    <ul class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-brand-line bg-brand-line sm:grid-cols-2">
      {OUTCOMES.map((outcome, index) => (
        <li class="bg-white p-6 sm:p-8">
          <div class="flex items-start gap-5">
            <span class="grid size-11 shrink-0 place-items-center rounded-lg bg-brand-ink text-brand-orange" aria-hidden="true"><Icon name={outcome.icon} size={21} /></span>
            <div>
              <p class="font-mono text-[10px] font-bold tracking-[0.16em] text-neutral-500">0{index + 1}</p>
              <h3 class="mt-3 text-xl font-semibold tracking-tight text-brand-ink sm:text-2xl">{outcome.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-600">{outcome.scope}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <a href="/solutions" class="mt-8 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-orange-800 underline-offset-4 hover:underline">Explore all solutions <span aria-hidden="true">→</span></a>
  </div>
</section>
