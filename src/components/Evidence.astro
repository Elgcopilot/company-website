---
import type { CollectionEntry } from 'astro:content';

interface Props { studies: CollectionEntry<'case-studies'>[]; }
const { studies } = Astro.props;
---

<section class="bg-white" aria-labelledby="evidence-title">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="max-w-3xl">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-orange-800">Deployed evidence</p>
      <h2 id="evidence-title" class="mt-4 text-balance text-4xl font-semibold leading-[1.03] tracking-[-0.035em] text-brand-ink sm:text-6xl">Different industries. The same engineering discipline.</h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-600">We turn physical constraints into working systems, from race control to connected stores and field AI.</p>
    </div>
    <div class="mt-12 grid gap-5 lg:grid-cols-12">
      {studies.map((study, index) => (
        <article class:list={['group overflow-hidden rounded-2xl border border-brand-line bg-brand-paper', index === 0 ? 'lg:col-span-6 lg:row-span-2' : 'lg:col-span-6']}>
          <a href={`/case-studies/${study.slug}`} class:list={['grid h-full', index === 0 ? '' : 'sm:grid-cols-[0.9fr_1.1fr]']}>
            <div class:list={['relative overflow-hidden bg-neutral-200', index === 0 ? 'aspect-[4/3]' : 'aspect-[16/9] sm:aspect-auto sm:min-h-60']}>
              <img src={study.data.featuredImage} alt="" loading="lazy" width="1200" height="800" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-crisp group-hover:scale-[1.025]" />
              <span class="absolute inset-0 bg-gradient-to-t from-black/25 to-transparent"></span>
            </div>
            <div class="flex flex-col justify-center p-6 sm:p-8">
              <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-orange-800">{study.data.industry}</p>
              <h3 class:list={['mt-3 font-semibold leading-tight tracking-[-0.025em] text-brand-ink', index === 0 ? 'text-3xl' : 'text-2xl']}>{study.data.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-600">{study.data.subtitle}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-ink">View deployed system <span aria-hidden="true" class="text-brand-ember transition-transform group-hover:translate-x-1">→</span></span>
            </div>
          </a>
        </article>
      ))}
    </div>
    <a href="/case-studies" class="mt-8 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-orange-800 underline-offset-4 hover:underline">See all case studies <span aria-hidden="true">→</span></a>
  </div>
</section>
