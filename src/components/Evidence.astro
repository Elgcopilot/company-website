---
/**
 * Evidence — dark editorial evidence section (zero JS).
 * One large feature story + supporting stories, driven by real collections.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  feature: CollectionEntry<'case-studies'>;
  supporting: CollectionEntry<'case-studies'>[];
}

const { feature, supporting } = Astro.props;
const [first, ...rest] = feature.data.metrics.slice(0, 3);
---

<section class="bg-brand-coal text-white" aria-label="Featured field evidence">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-neutral-400">03 — Field evidence</p>
        <h2 class="mt-4 max-w-2xl text-3xl font-semibold leading-[1.05] tracking-[-0.03em] sm:text-5xl">
          Proven where failure is not an option.
        </h2>
      </div>
      <a href="/case-studies" class="text-sm font-semibold text-neutral-300 transition-colors hover:text-brand-orange">
        All case studies →
      </a>
    </div>

    <!-- Feature story -->
    <article class="mt-12 grid overflow-hidden rounded-2xl bg-white/[0.04] ring-1 ring-white/10 lg:grid-cols-2" data-reveal>
      <a href={`/case-studies/${feature.slug}`} class="group relative block min-h-[280px] overflow-hidden lg:min-h-[420px]" aria-label={`Read case study: ${feature.data.title}`}>
        <img
          src={feature.data.featuredImage}
          alt={feature.data.title}
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
        />
        <span class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></span>
        {feature.data.clientPartner && (
          <span class="absolute left-5 top-5 rounded-md bg-white/90 px-3 py-1.5 font-mono text-[11px] font-bold tracking-wider text-brand-ink backdrop-blur">
            {feature.data.clientPartner}
          </span>
        )}
      </a>
      <div class="flex flex-col justify-center p-7 sm:p-10 lg:p-12">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-orange">
          {feature.data.industry} · {feature.data.projectType}
        </p>
        <h3 class="mt-3 text-2xl font-semibold leading-tight tracking-tight sm:text-4xl">
          <a href={`/case-studies/${feature.slug}`} class="transition-colors hover:text-brand-orange">
            {feature.data.title}
          </a>
        </h3>
        <p class="mt-4 leading-relaxed text-neutral-400">{feature.data.subtitle}</p>
        <dl class="mt-7 grid grid-cols-3 gap-4 border-t border-white/10 pt-6 font-mono">
          {[first, ...rest].filter(Boolean).map((m) => m && (
            <div>
              <dd class="text-lg font-bold tracking-tight text-white sm:text-xl">{m.value}</dd>
              <dt class="mt-1 text-[10px] uppercase tracking-[0.14em] text-neutral-500">{m.label}</dt>
            </div>
          ))}
        </dl>
        <p class="mt-7">
          <a href={`/case-studies/${feature.slug}`} class="group inline-flex items-center gap-2 text-sm font-semibold text-white">
            <span class="border-b border-brand-orange pb-0.5 transition-colors group-hover:text-brand-orange">Read the evidence</span>
            <span aria-hidden="true" class="text-brand-orange transition-transform duration-200 group-hover:translate-x-1">→</span>
          </a>
        </p>
      </div>
    </article>

    <!-- Supporting stories -->
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {supporting.map((s) => (
        <article class="group overflow-hidden rounded-2xl bg-white/[0.04] ring-1 ring-white/10 transition-colors duration-300 hover:bg-white/[0.07]" data-reveal>
          <a href={`/case-studies/${s.slug}`} class="block" aria-label={`Read case study: ${s.data.title}`}>
            <div class="relative aspect-[16/8] overflow-hidden">
              <img
                src={s.data.featuredImage}
                alt={s.data.title}
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
              />
              <span class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-transparent"></span>
              {s.data.clientPartner && (
                <span class="absolute left-4 top-4 rounded-md bg-white/90 px-2.5 py-1 font-mono text-[11px] font-bold tracking-wider text-brand-ink backdrop-blur">
                  {s.data.clientPartner}
                </span>
              )}
              <span class="absolute bottom-4 left-4 rounded-md bg-black/55 px-2.5 py-1 font-mono text-[11px] font-medium text-white backdrop-blur">
                {s.data.status}
              </span>
            </div>
            <div class="p-6 sm:p-7">
              <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-orange">
                {s.data.industry}
              </p>
              <h3 class="mt-2 text-xl font-semibold leading-snug tracking-tight transition-colors group-hover:text-brand-orange">
                {s.data.title}
              </h3>
              <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-neutral-400">{s.data.subtitle}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
