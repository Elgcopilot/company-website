---
const LOGOS = [
  { src: '/images/clients/isuzu.png', alt: 'ISUZU' },
  { src: '/images/clients/lg.png', alt: 'LG' },
  { src: '/images/clients/toyota-trd.png', alt: 'Toyota Racing Development' },
  { src: '/images/clients/tera.png', alt: 'Tera Motors' },
  { src: '/images/clients/burapha-university.png', alt: 'Burapha University' },
  { src: '/images/clients/pt.png', alt: 'PT Maxnitron Racing Series' },
];
---

<section class="border-y border-brand-line bg-white" aria-labelledby="trusted-title">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <p id="trusted-title" class="text-center font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-neutral-600">
      Systems deployed with
    </p>
    <ul class="mt-7 grid grid-cols-3 items-center gap-x-8 gap-y-7 md:grid-cols-6" aria-label="Clients and partners">
      {LOGOS.map((logo) => (
        <li class="flex min-h-12 items-center justify-center">
          <img src={logo.src} alt={logo.alt} loading="lazy" width="360" height="120" class="max-h-10 w-auto max-w-full object-contain grayscale opacity-70" />
        </li>
      ))}
    </ul>
  </div>
</section>
